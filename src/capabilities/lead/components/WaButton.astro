---
/**
 * WaButton — aksi WhatsApp LEAD.
 *
 * Nomor hanya dari konfigurasi proyek; tanpa nomor, komponen tidak merender
 * apa pun (tidak pernah `href="#"`). Kelas visual (`btn--*`) dipasok design
 * system halaman, jadi kemampuan lead ini tetap generik.
 */
import { buildWaLink } from '../lib/whatsapp';
import type { LeadLocation } from '../lib/track';

export interface Props {
  text?: string;
  message?: string;
  number?: string;
  variant?: 'primary' | 'ghost' | 'onink' | 'floating';
  /** Sumber klik, supaya satu event tidak ambigu lintas blok. */
  location?: LeadLocation;
  class?: string;
  slot?: string;
  ariaLabel?: string;
}

const {
  text = 'Hubungi via WhatsApp',
  message = 'Halo, saya ingin bertanya tentang layanan kalian.',
  number,
  variant = 'primary',
  location = 'hero',
  class: className = '',
  slot: slotName,
  ariaLabel,
} = Astro.props;

/**
 * Label aksesibel harus memuat teks yang terlihat (WCAG 2.5.3 Label in Name).
 * `aria-label` yang tidak mengandung teks tombol membuat pembaca layar
 *进步的 nama berbeda dari yang dibaca pengguna mata. Karena itu label default
 * memakai `text` sebagai dasarnya, bukan kalimat terpisah.
 */
const resolvedAriaLabel = ariaLabel ?? `${text} via WhatsApp`;

const waUrl = buildWaLink({ number, text: message });
const hasNumber = waUrl !== '#';
const buttonClass = variant === 'onink' ? 'btn btn--on-ink' : variant === 'ghost' ? 'btn btn--ghost' : 'btn btn--primary';
---

{
  hasNumber &&
    (variant === 'floating' ? (
      <div class="cta-bar" aria-label="Aksi cepat kontak">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={resolvedAriaLabel}
          data-event="whatsapp_click"
          data-wa-location={location}
          class:list={[buttonClass, 'w-full', className]}
        >
          <span>{text}</span>
        </a>
      </div>
    ) : (
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={resolvedAriaLabel}
        data-event="whatsapp_click"
        data-wa-location={location}
        slot={slotName}
        class:list={[buttonClass, className]}
      >
        <span>{text}</span>
      </a>
    ))
}

<script>
  import { track, type LeadLocation } from '../lib/track';

  // Satu listener terdelegasi per halaman; guard membuat instance tambahan no-op.
  if (!window.__waTrackBound) {
    window.__waTrackBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLElement>('[data-event="whatsapp_click"]');
      if (!trigger) return;
      track('whatsapp_click', { location: (trigger.dataset.waLocation ?? 'unknown') as LeadLocation });
    });
  }
</script>
