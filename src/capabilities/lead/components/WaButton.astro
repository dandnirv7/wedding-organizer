---
/**
 * WaButton — aksi WhatsApp LEAD. Penomoran hanya dari konfigurasi proyek;
 * tanpa nomor, komponen tidak merender apa pun (tidak pernah href="#").
 * Styling visual milik design system halaman lewat kelas `.select-line`.
 */
import { buildWaLink } from '../lib/whatsapp';

export interface Props {
  text?: string;
  message?: string;
  number?: string;
  variant?: 'line' | 'quiet' | 'floating';
  class?: string;
  ariaLabel?: string;
}

const {
  text = 'Hubungi via WhatsApp',
  message = 'Halo, saya ingin bertanya tentang layanan kalian.',
  number,
  variant = 'line',
  class: className = '',
  ariaLabel = 'Hubungi tim kami via WhatsApp',
} = Astro.props;

const waUrl = buildWaLink({ number, text: message });
const hasNumber = waUrl !== '#';
---

{
  hasNumber &&
    (variant === 'floating' ? (
      <aside
        aria-label="Aksi cepat kontak"
        class="field-table fixed inset-x-0 bottom-0 z-50 border-t border-hairline-table md:hidden"
      >
        <div class="sheet flex justify-center py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={ariaLabel}
            data-event="lead_whatsapp_click"
            class:list={['select-line', 'select-line--quiet', className]}
          >
            <span>{text}</span>
          </a>
        </div>
      </aside>
    ) : (
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ariaLabel}
        data-event="lead_whatsapp_click"
        class:list={['select-line', { 'select-line--quiet': variant === 'quiet' }, className]}
      >
        <span>{text}</span>
      </a>
    ))
}

<script>
  import { track } from '../lib/track';

  // Satu listener terdelegasi per halaman; guard membuat instance tambahan no-op.
  if (!(window as { __waTrackBound?: boolean }).__waTrackBound) {
    (window as { __waTrackBound?: boolean }).__waTrackBound = true;
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (!target.closest('[data-event="lead_whatsapp_click"]')) return;
      track('lead_whatsapp_click');
    });
  }
</script>
