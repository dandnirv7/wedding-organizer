---
/**
 * WaButton — aksi WhatsApp LEAD. Nomor hanya dari konfigurasi proyek; tanpa nomor,
 * komponen tidak merender apa pun (tidak pernah href="#").
 * `line`  = baris teks beranak panah di bidang kertas ( kelas `.cue-link`).
 * `band`  = baris aksi rata kiri di bidang tinta, satu-satunya tempat stabilo dipakai.
 * `floating` = band yang menempel di bawah, hanya layar sempit.
 */
import { buildWaLink } from '../lib/whatsapp';

export interface Props {
  text?: string;
  message?: string;
  number?: string;
  variant?: 'line' | 'band' | 'floating';
  class?: string;
  ariaLabel?: string;
}

const {
  text = 'Hubungi via WhatsApp',
  message = 'Halo, saya ingin bertanya tentang layanan kalian.',
  number,
  variant = 'line',
  class: className = '',
  ariaLabel = 'Hubungi tim kami via WhatsApp',
} = Astro.props;

const waUrl = buildWaLink({ number, text: message });
const hasNumber = waUrl !== '#';
const bandClass =
  'flex min-h-11 w-full items-center justify-between gap-4 bg-table px-[clamp(1.25rem,4vw,2rem)] py-3 font-data text-[0.8125rem] font-bold uppercase tracking-[0.1em] text-select';
---

{
  hasNumber &&
    (variant === 'line' ? (
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={ariaLabel}
        data-event="lead_whatsapp_click"
        class:list={['cue-link', className]}
      >
        <span>{text}</span>
      </a>
    ) : (
      <div
        aria-label="Aksi cepat kontak"
        class:list={[
          'border-t border-hairline-table',
          variant === 'floating' && 'fixed inset-x-0 bottom-0 z-50 md:hidden',
        ]}
      >
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={ariaLabel}
          data-event="lead_whatsapp_click"
          class:list={[
            bandClass,
            variant === 'floating' && 'pb-[max(0.75rem,env(safe-area-inset-bottom))]',
            className,
          ]}
        >
          <span>{text}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    ))
}

<script>
  import { track } from '../lib/track';

  // Satu listener terdelegasi per halaman; guard membuat instance tambahan no-op.
  if (!(window as { __waTrackBound?: boolean }).__waTrackBound) {
    (window as { __waTrackBound?: boolean }).__waTrackBound = true;
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (!target.closest('[data-event="lead_whatsapp_click"]')) return;
      track('lead_whatsapp_click');
    });
  }
</script>
