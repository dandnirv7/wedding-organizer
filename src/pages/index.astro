---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveCanonical } from '../lib/seo';
import {
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildWebPageSchema,
} from '../lib/schema';
import { WaButton } from '../capabilities/lead/index.js';
import { siteConfig } from '../config/site';
import SheetNav from './_wedding/SheetNav.astro';
import FramePlate from './_wedding/FramePlate.astro';
import CreditLine from './_wedding/CreditLine.astro';
import SelectMark from './_wedding/SelectMark.astro';
import EdgeBand from './_wedding/EdgeBand.astro';
import SelectStrip from './_wedding/SelectStrip.astro';
import ServiceLedger from './_wedding/ServiceLedger.astro';
import FaqSheet from './_wedding/FaqSheet.astro';
import Colophon from './_wedding/Colophon.astro';
import PalettePicker from './_wedding/PalettePicker.astro';
import { paletteBootstrap } from './_wedding/palettes';
import { copy, services, frames, storyFrames } from './_wedding/copy';

const canonicalUrl = resolveCanonical(Astro.url);
const graph = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema(canonicalUrl, copy.sheet.title, copy.sheet.description),
];

/** Baris kepala section: aturan cetak + data folio, bukan kicker marketing. */
const hasWa = Boolean(siteConfig.contact.whatsapp);
---

<BaseLayout title={copy.sheet.title} description={copy.sheet.description} canonical={canonicalUrl} graph={graph}>
  <!-- Pra-paint: pasang palet tersimpan sebelum gaya pertama dihitung. -->
  <script slot="head" is:inline set:html={paletteBootstrap} />

  <SheetNav slot="header" items={copy.sheet.nav}>
    <WaButton slot="cta" variant="quiet" text="Chat via WhatsApp" message={copy.waMessage} />
  </SheetNav>

  {/* 01 HERO — bidang meja penuh; pelat menguasai, teks di tepi kiri */}
  <section class="field-table">
    <div class="sheet grid items-end gap-x-8 gap-y-10 pt-10 pb-12 lg:grid-cols-12 lg:pt-16 lg:pb-16">
      <div class="lg:col-span-5 lg:pb-6">
        <p class="folio">{copy.hero.folio}</p>
        <h1 class="display mt-5">{copy.hero.title}</h1>
        <p class="lede mt-6 opacity-90">{copy.hero.lede}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
          <SelectMark href="#work" label={copy.hero.action} />
          {hasWa && <WaButton variant="quiet" text="Chat via WhatsApp" message={copy.waMessage} />}
        </div>
      </div>
      <div class="lg:col-span-7">
        <FramePlate
          no={frames.hero.no}
          caption={frames.hero.caption}
          width={frames.hero.width}
          height={frames.hero.height}
          selected
          eager
        />
        <CreditLine no={frames.hero.no} class="mt-3" />
      </div>
    </div>
    <EdgeBand roll="roll 01 · menunggu aset" />
  </section>

  {/* 02 SIKAP — bidang kertas */}
  <section class="field-paper">
    <div class="sheet sheet-block">
      <div class="flex items-center gap-5 border-t border-hairline pt-3">
        <span class="folio">02 · {copy.statement.label}</span>
        <span class="strip ml-auto">satu halaman</span>
      </div>
      <h2 class="h-section mt-8">{copy.statement.headline}</h2>
      <p class="lede mt-5">{copy.statement.body}</p>
    </div>
  </section>

  {/* 03 FEATURED WEDDING — pelat dominan memecah gutter */}
  <section id="work" class="field-paper scroll-mt-24 border-t border-hairline">
    <div class="sheet pb-16 md:pb-24">
      <div class="flex items-center gap-5 border-t border-hairline pt-3">
        <span class="folio">03 · {copy.featured.label}</span>
        <span class="strip ml-auto">#work</span>
      </div>
      <h2 class="h-section mt-8">{copy.featured.headline}</h2>
      <div class="mt-10 grid gap-x-8 gap-y-10 lg:grid-cols-12">
        <figure class="lg:col-span-7 lg:-ms-10">
          <FramePlate
            no={frames.featured.no}
            caption={frames.featured.caption}
            width={frames.featured.width}
            height={frames.featured.height}
            selected
          />
          <CreditLine no={frames.featured.no} class="mt-3" />
        </figure>
        <div class="lg:col-span-5 lg:pt-14">
          <FramePlate
            no={frames.support.no}
            caption={frames.support.caption}
            width={frames.support.width}
            height={frames.support.height}
          />
          <CreditLine no={frames.support.no} class="mt-3" />
          <p class="lede mt-7">{copy.featured.pending}</p>
        </div>
      </div>
    </div>
  </section>

  {/* 04 LAYANAN — daftar, bukan kartu; pelat desktop bertukar tanpa JS */}
  <section id="services" class="field-paper scroll-mt-24 border-t border-hairline">
    <div class="sheet py-16 md:py-24">
      <div class="flex items-center gap-5 border-t border-hairline pt-3">
        <span class="folio">04 · {copy.services.label}</span>
        <span class="strip ml-auto">#services</span>
      </div>
      <h2 class="h-section mt-8">{copy.services.headline}</h2>
      <div class="mt-10">
        <ServiceLedger items={services} note={copy.services.note} />
      </div>
    </div>
  </section>

  {/* 05 PROSES — empat langkah sebagai folio, tanpa ikon */}
  <section id="process" class="field-paper scroll-mt-24 border-t border-hairline">
    <div class="sheet py-16 md:py-24">
      <div class="flex items-center gap-5 border-t border-hairline pt-3">
        <span class="folio">05 · {copy.process.label}</span>
        <span class="strip ml-auto">04 langkah</span>
      </div>
      <h2 class="h-section mt-8">{copy.process.headline}</h2>
      <ol class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-4">
        {copy.process.steps.map((step) => (
          <li class="border-t border-hairline pt-5">
            <p class="strip">{step.no}</p>
            <h3 class="h-item mt-3">{step.name}</h3>
            <p class="lede mt-2 text-[1rem]">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 06 VIDEO BREAK — bidang meja, satu caption pendek */}
  <section class="field-table">
    <div class="sheet py-16 md:py-24">
      <FramePlate no={frames.video.no} caption={frames.video.caption} width={frames.video.width} height={frames.video.height} />
      <div class="mt-6 flex flex-wrap items-baseline gap-x-8 gap-y-3">
        <CreditLine no={frames.video.no} />
        <h2 class="h-section text-[clamp(1.35rem,3vw,1.9rem)]">{copy.video.headline}</h2>
      </div>
      <p class="strip mt-4">{copy.video.pending}</p>
    </div>
  </section>

  {/* 07 VISUAL STORY — strip asimetris, satu lingkaran seleksi */}
  <section class="field-paper">
    <div class="sheet py-16 md:py-24">
      <div class="flex items-center gap-5 border-t border-hairline pt-3">
        <span class="folio">07 · {copy.story.label}</span>
        <span class="strip ml-auto">05 pelat</span>
      </div>
      <h2 class="h-section mt-8">{copy.story.headline}</h2>
      <div class="mt-10">
        <SelectStrip>
          {storyFrames.map((frame, i) => (
            <FramePlate
              no={frame.no}
              caption={frame.caption}
              width={frame.width}
              height={frame.height}
              selected={i === 2}
            />
          ))}
        </SelectStrip>
        <p class="lede mt-8">{copy.story.pending}</p>
      </div>
    </div>
    <EdgeBand roll="roll 02 · menunggu aset" frame="detail" />
  </section>

  {/* 08 TESTIMONI — tipe baca besar di kertas, tanpa carousel/rating */}
  <section class="field-paper">
    <div class="sheet py-16 md:py-24">
      <div class="flex items-center gap-5 border-t border-hairline pt-3">
        <span class="folio">08 · {copy.testimonial.label}</span>
        <span class="strip ml-auto">maks 03</span>
      </div>
      <h2 class="h-section mt-8">{copy.testimonial.headline}</h2>
      <figure class="mt-10 border-t border-hairline pt-8">
        <blockquote class="h-section text-[clamp(1.5rem,3.5vw,2.125rem)] font-normal italic opacity-70">
          “Kutipan menunggu izin tertulis dari pasangan.”
        </blockquote>
        <figcaption class="mt-6">
          <CreditLine no="T1" place="menunggu izin" />
          <p class="lede mt-4">{copy.testimonial.pending}</p>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* 09 TENTANG — pelat tim + cerita yang belum dikonfirmasi */}
  <section id="about" class="field-paper scroll-mt-24 border-t border-hairline">
    <div class="sheet py-16 md:py-24">
      <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <FramePlate no={frames.team.no} caption={frames.team.caption} width={frames.team.width} height={frames.team.height} />
          <CreditLine no={frames.team.no} class="mt-3" />
        </div>
        <div class="lg:col-span-7 lg:pt-10">
          <div class="flex items-center gap-5 border-t border-hairline pt-3">
            <span class="folio">09 · {copy.about.label}</span>
            <span class="strip ml-auto">#about</span>
          </div>
          <h2 class="h-section mt-8">{copy.about.headline}</h2>
          <p class="lede mt-5">{copy.about.pending}</p>
        </div>
      </div>
    </div>
  </section>

  {/* 10 TANYA — disclosure native, tanpa skrip */}
  <section id="faq" class="field-paper scroll-mt-24 border-t border-hairline">
    <div class="sheet py-16 md:py-24">
      <div class="flex items-center gap-5 border-t border-hairline pt-3">
        <span class="folio">10 · {copy.faq.label}</span>
        <span class="strip ml-auto">#faq</span>
      </div>
      <h2 class="h-section mt-8">{copy.faq.headline}</h2>
      <FaqSheet items={copy.faq.items} />
    </div>
  </section>

  {/* 11 AKHIR — bidang meja, satu aksi, pelat penutup */}
  <section class="field-table">
    <div class="sheet py-16 md:py-24">
      <div class="grid gap-x-8 gap-y-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-5">
          <p class="folio">11 · akhir lembar</p>
          <h2 class="h-section mt-5">{copy.finalCta.headline}</h2>
          <p class="lede mt-5 opacity-90">{copy.finalCta.body}</p>
          <div class="mt-8">
            {hasWa ? (
              <WaButton text={copy.finalCta.action} message={copy.waMessage} />
            ) : (
              <p class="strip">{copy.finalCta.noNumber}</p>
            )}
          </div>
        </div>
        <div class="lg:col-span-7">
          <FramePlate no={frames.closing.no} caption={frames.closing.caption} width={frames.closing.width} height={frames.closing.height} />
          <CreditLine no={frames.closing.no} class="mt-3" />
        </div>
      </div>
    </div>
  </section>

  <Colophon slot="footer" />
  <PalettePicker />
  <WaButton variant="floating" text={copy.floatingCta} message={copy.waMessage} />
</BaseLayout>
