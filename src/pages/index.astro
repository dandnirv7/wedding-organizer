---
/**
 * `/` — satu rute, tiga belas blok.
 *
 * Urutan, komposisi, dan ritme diambil dari docs/references/ui/*.png (desktop,
 * tablet, mobile): band ivory / beige / charcoal bergantian, tipografi editorial
 * tanpa kartu, grid asimetris, dan konversi berakhir di satu blok inquiry.
 *
 * Yang tidak boleh bocor ke sini: nomor WhatsApp, harga, nama pasangan, dan
 * testimoni. Semuanya datang dari `siteConfig` atau `content.ts`; kalau belum
 * ada isinya, blok menampilkannya sebagai status berlabel.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveCanonical } from '../lib/seo';
import { buildOrganizationSchema, buildWebPageSchema, buildWebSiteSchema } from '../lib/schema';
import SiteHeader from './_wedding/SiteHeader.astro';
import SiteFooter from './_wedding/SiteFooter.astro';
import SectionHead from './_wedding/SectionHead.astro';
import FramePlate from './_wedding/FramePlate.astro';
import MediaStage from './_wedding/MediaStage.astro';
import FaqList from './_wedding/FaqList.astro';
import InquiryForm from './_wedding/InquiryForm.astro';
import CtaLink from './_wedding/CtaLink.astro';
import WaitNote from './_wedding/WaitNote.astro';
import TestimonialSlider from './_wedding/TestimonialSlider.astro';
import {
  page,
  frames,
  stories,
  storyMeta,
  craftKeywords,
  behindTheDay,
  services,
  craftLegend,
  steps,
  team,
  testimonials,
  faq,
} from './_wedding/content';

const canonicalUrl = resolveCanonical(Astro.url);
const graph = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema(canonicalUrl, page.meta.title, page.meta.description),
];

const [story] = stories;
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={page.meta.title} description={page.meta.description} canonical={canonicalUrl} graph={graph}>
  <SiteHeader slot="header" items={page.nav}>
    <CtaLink slot="cta" text={page.headerCta} location="header" variant="quiet" />
  </SiteHeader>

  <!-- 01 · HERO — bidang gelap, klaim di kiri, hari-H di kanan -->
  <section class="band band--ink hero" aria-labelledby="hero-title">
    <div class="wrap wrap--slim hero__grid">
      <div class="hero__text">
        <p class="label label--accent gs-hero-item">{page.hero.eyebrow}</p>
        <h1 class="t-display hero__title gs-hero-item" id="hero-title">{page.hero.title}</h1>
        <p class="lede hero__lede gs-hero-item">{page.hero.lede}</p>
        <div class="hero__cta gs-hero-item">
          <CtaLink text={page.hero.primaryCta} location="hero" variant="onink" />
          <a class="link-arrow link-arrow--ink" href={page.hero.secondaryTarget}>
            {page.hero.secondaryCta}
            <span class="link-arrow__mark" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <MediaStage frame={frames.hero} class="hero__media gs-hero-media" />
    </div>
  </section>

  <!-- 02 · TENTANG — bidang sunyi + deretan label -->
  <section class="band band--beige band--tight" id="tentang" aria-labelledby="tentang-title">
    <div class="wrap">
      <SectionHead
        eyebrow={page.intro.eyebrow}
        headline={page.intro.headline}
        lede={page.intro.lede}
        headingId="tentang-title"
      />
      <ul class="keywords">
        {
          craftKeywords.map((keyword, i) => (
            <li class="keywords__item">
              {i > 0 && <span class="keywords__mark" aria-hidden="true">+</span>}
              <span>{keyword}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 03 · CERITA PERNIKAHAN — grid asimetris + tiga baris data -->
  <section class="band band--ivory band--air" id="pernikahan" aria-labelledby="pernikahan-title">
    <div class="wrap">
      <SectionHead
        eyebrow={page.portfolio.eyebrow}
        headline={page.portfolio.headline}
        lede={page.portfolio.lede}
        headingId="pernikahan-title"
      />
      <div class="grid-portfolio">
        <FramePlate
          frame={story.frames[0]}
          class="grid-portfolio__a"
          sizes="(min-width: 64rem) 54vw, (min-width: 48rem) 67vw, 100vw"
          widths={[420, 680, 900]}
        />
        <div class="grid-portfolio__stack">
          <FramePlate
            frame={story.frames[1]}
            sizes="(min-width: 64rem) 26vw, (min-width: 48rem) 33vw, 100vw"
            widths={[340, 520, 680]}
          />
          <FramePlate
            frame={story.frames[2]}
            sizes="(min-width: 64rem) 26vw, (min-width: 48rem) 33vw, 100vw"
            widths={[340, 520, 680]}
          />
        </div>
      </div>
      <dl class="meta-grid">
        {
          storyMeta.map((item) => (
            <div class="meta-grid__item">
              <dt class="label">{item.label}</dt>
              <dd class="prose">{item.value ?? <span class="pending">{item.note}</span>}</dd>
            </div>
          ))
        }
      </dl>
      <WaitNote text={page.portfolio.note} class="mt-6" />
    </div>
  </section>

  <!-- 04 · SATU HARI — bidang gelap, satu bidang lebar + tiga kolom -->
  <section class="band band--ink" aria-labelledby="satu-hari-title">
    <div class="wrap">
      <SectionHead
        eyebrow={page.behind.eyebrow}
        headline={page.behind.headline}
        lede={page.behind.lede}
        headingId="satu-hari-title"
        accent
      />
      <FramePlate
        frame={frames.craft}
        class="field-wide mt-6"
        sizes="(min-width: 72rem) 1152px, 100vw"
        widths={[420, 680, 900, 1200]}
      />
      <ol class="cols cols--3 mt-12">
        {
          behindTheDay.map((item) => (
            <li class="col">
              <p class="col__label">
                <span class="figure">{item.no}</span> {item.name}
              </p>
              <p class="col__body mt-4">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 05 · LAYANAN — empat baris bernomor, bukan kartu -->
  <section class="band band--ivory band--air" id="layanan" aria-labelledby="layanan-title">
    <div class="wrap">
      <SectionHead
        eyebrow={page.services.eyebrow}
        headline={page.services.headline}
        lede={page.services.lede}
        headingId="layanan-title"
        accent
      />
      <ul class="rows">
        {
          services.map((service, i) => (
            <li class="row">
              <span class="row__no figure">{pad(i + 1)}</span>
              <h3 class="row__name">{service.name}</h3>
              <p class="row__body">{service.summary}</p>
              <a class="row__arrow" href={page.formAnchor} aria-label={`Tanya layanan ${service.name}`}>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <WaitNote text={page.services.note} class="mt-10" />
    </div>
  </section>

  <!-- 06 · PEKERJAAN YANG TAK SELALU TERLIHAT — grid editorial + legenda -->
  <section class="band band--beige" aria-labelledby="detail-title">
    <div class="wrap">
      <SectionHead
        eyebrow={page.craft.eyebrow}
        headline={page.craft.headline}
        lede={page.craft.lede}
        headingId="detail-title"
      />
      <div class="grid-detail">
        <FramePlate
          frame={frames.detail[0]}
          class="grid-detail__a"
          sizes="(min-width: 64rem) 50vw, (min-width: 48rem) 62vw, 100vw"
          widths={[380, 560, 780]}
        />
        <div class="grid-detail__stack">
          <FramePlate
            frame={frames.detail[1]}
            sizes="(min-width: 64rem) 26vw, (min-width: 48rem) 38vw, 50vw"
            widths={[200, 360, 520]}
          />
          <FramePlate
            frame={frames.detail[2]}
            sizes="(min-width: 64rem) 26vw, (min-width: 48rem) 38vw, 50vw"
            widths={[200, 360, 520]}
          />
        </div>
        <div class="grid-detail__row">
          <FramePlate
            frame={frames.detail[3]}
            sizes="(min-width: 64rem) 26vw, (min-width: 48rem) 33vw, 50vw"
            widths={[200, 360, 520]}
          />
          <FramePlate
            frame={frames.detail[4]}
            sizes="(min-width: 64rem) 26vw, (min-width: 48rem) 33vw, 50vw"
            widths={[200, 360, 520]}
          />
          <FramePlate
            frame={frames.detail[5]}
            sizes="(min-width: 64rem) 26vw, (min-width: 48rem) 33vw, 100vw"
            widths={[340, 520, 680]}
          />
        </div>
      </div>
      <ul class="legend">
        {
          craftLegend.map((item, i) => (
            <li class="legend__item">
              <span>{item}</span>
              {i < craftLegend.length - 1 && <span class="legend__rule" aria-hidden="true" />}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 07 · CARA KAMI BEKERJA — empat langkah + tiga bidang -->
  <section class="band band--ivory" id="proses" aria-labelledby="proses-title">
    <div class="wrap">
      <SectionHead
        eyebrow={page.process.eyebrow}
        headline={page.process.headline}
        lede={page.process.lede}
        headingId="proses-title"
        accent
      />
      <ol class="cols cols--4 cols--ruled mt-6">
        {
          steps.map((step, i) => (
            <li class="col">
              <h3 class="col__label">
                <span class="figure">{pad(i + 1)}</span> {step.name}
              </h3>
              <p class="col__body mt-4">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="grid-process mt-6">
        <FramePlate
          frame={frames.process[0]}
          sizes="(min-width: 64rem) 40vw, 50vw"
          widths={[340, 520, 680]}
        />
        <FramePlate
          frame={frames.process[1]}
          sizes="(min-width: 64rem) 20vw, 50vw"
          widths={[200, 360, 520]}
        />
        <FramePlate
          frame={frames.process[2]}
          sizes="(min-width: 64rem) 20vw, 50vw"
          widths={[200, 360, 520]}
        />
      </div>
    </div>
  </section>

  <!-- 08 · TIM — potret + peran, nama menunggu aset -->
  <section class="band band--ivory" aria-labelledby="tim-title">
    <div class="wrap">
      <SectionHead
        eyebrow={page.team.eyebrow}
        headline={page.team.headline}
        lede={page.team.lede}
        headingId="tim-title"
      />
      <div class="grid-team mt-6">
        {
          team.map((member, i) => (
            <article class="person">
              <FramePlate
                frame={member.frame}
                sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 33vw, 50vw"
                widths={[200, 360, 520]}
              />
              <h3 class="label person__name">
                {member.name ?? `Nama tim ${pad(i + 1)} menunggu aset`}
              </h3>
              <p class="prose">{member.role} · {member.body}</p>
            </article>
          ))
        }
      </div>
      <WaitNote text={page.team.note} class="mt-10" />
    </div>
  </section>

  <!-- 09 · CERITA DARI PASANGAN — kartu testimoni -->
  <section class="band band--beige" id="testimoni" aria-labelledby="testimoni-title">
    <div class="wrap">
      <SectionHead eyebrow={page.voices.eyebrow} headline={page.voices.headline} headingId="testimoni-title" />
      <TestimonialSlider testimonials={testimonials} eyebrow={page.voices.eyebrow} />
      <WaitNote text={page.voices.note} class="mt-6" />
    </div>
  </section>

  <!-- 10 · FAQ — disclosure native, tanpa skrip -->
  <section class="band band--ivory" id="tanya" aria-labelledby="tanya-title">
    <div class="wrap">
      <SectionHead eyebrow={page.faq.eyebrow} headline={page.faq.headline} headingId="tanya-title" accent />
      <FaqList
        items={faq}
        pendingAnswer={page.faq.pendingAnswer}
        ctaLabel={page.faq.cta}
        waMessage={page.waMessage}
      />
    </div>
  </section>

  <!-- 11 · INQUIRY — closure: cerita di kiri, form pesan di kanan -->
  <section class="band band--ivory" id="mulainya" aria-labelledby="mulainya-title">
    <div class="wrap">
      <div class="grid-inquiry">
        <div class="grid-inquiry__intro">
          <p class="label">{page.inquiry.eyebrow}</p>
          <h2 class="t-section block__title" id="mulainya-title">{page.inquiry.headline}</h2>
          <p class="lede block__lede">{page.inquiry.lede}</p>
          <FramePlate
            frame={frames.form}
            class="mt-6"
            sizes="(min-width: 64rem) 38vw, 100vw"
            widths={[340, 520, 680]}
          />
        </div>
        <InquiryForm
          eyebrow={page.inquiry.formEyebrow}
          hint={page.inquiry.formHint}
          submit={page.inquiry.submit}
        />
      </div>
    </div>
  </section>

  <!-- 12 · FINAL CTA — bidang gelap, satu kalimat + satu tautan -->
  <section class="band band--ink band--tight" aria-labelledby="penutup-title">
    <div class="wrap wrap--slim grid-closing">
      <div>
        <h2 class="t-section t-section--lead" id="penutup-title">{page.closing.headline}</h2>
        <CtaLink
          text={page.closing.cta}
          location="final_cta"
          variant="quiet"
          class="link-arrow--ink mt-6 block"
        />
      </div>
      <FramePlate
        frame={frames.closing}
        sizes="(min-width: 64rem) 42vw, 100vw"
        widths={[380, 560, 780]}
      />
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let mm: gsap.MatchMedia | null = null;

  function initAnimations() {
    // Bersihkan matchMedia dan ScrollTrigger sebelumnya jika ada (mis. navigasi via ClientRouter)
    if (mm) {
      mm.revert();
    }
    ScrollTrigger.getAll().forEach((t: any) => t.kill());

    mm = gsap.matchMedia();

    // Animasi dinamis penuh hanya jika pengguna TIDAK menyetel preferensi reduced-motion
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // 01 · Hero Cinematic Reveal
      gsap.from(".gs-hero-item", {
        y: 28,
        opacity: 0,
        duration: 1,
        stagger: 0.15,
        ease: "power3.out",
        clearProps: "all",
      });

      gsap.from(".gs-hero-media", {
        opacity: 0,
        duration: 1.2,
        delay: 0.2,
        ease: "power2.out",
        clearProps: "all",
      });

      // Kepala Seksi Universal (Sections 02 – 12)
      const sectionHeads = document.querySelectorAll("section:not(.hero) header.block");
      sectionHeads.forEach((head) => {
        gsap.from(head, {
          scrollTrigger: {
            trigger: head,
            start: "top 88%",
            once: true,
          },
          y: 24,
          opacity: 0,
          duration: 0.8,
          ease: "power2.out",
          clearProps: "all",
        });
      });

      // 02 · Tentang — Keywords Stagger
      const keywords = document.querySelectorAll("#tentang .keywords__item");
      if (keywords.length > 0) {
        gsap.from(keywords, {
          scrollTrigger: {
            trigger: "#tentang .keywords",
            start: "top 88%",
            once: true,
          },
          y: 16,
          opacity: 0,
          duration: 0.6,
          stagger: 0.08,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 03 · Cerita Pernikahan — Portfolio Frames & Metadata
      const portfolioPlates = document.querySelectorAll("#pernikahan .grid-portfolio .plate");
      if (portfolioPlates.length > 0) {
        gsap.from(portfolioPlates, {
          scrollTrigger: {
            trigger: "#pernikahan .grid-portfolio",
            start: "top 85%",
            once: true,
          },
          y: 32,
          opacity: 0,
          duration: 0.9,
          stagger: 0.15,
          ease: "power3.out",
          clearProps: "all",
        });
      }

      const metaItems = document.querySelectorAll("#pernikahan .meta-grid__item");
      if (metaItems.length > 0) {
        gsap.from(metaItems, {
          scrollTrigger: {
            trigger: "#pernikahan .meta-grid",
            start: "top 90%",
            once: true,
          },
          y: 16,
          opacity: 0,
          duration: 0.6,
          stagger: 0.08,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 04 · Satu Hari — Wide Plate & 3 Kolom
      const craftPlate = document.querySelector('section[aria-labelledby="satu-hari-title"] .field-wide');
      if (craftPlate) {
        gsap.from(craftPlate, {
          scrollTrigger: {
            trigger: craftPlate,
            start: "top 85%",
            once: true,
          },
          opacity: 0,
          y: 28,
          duration: 0.9,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      const craftCols = document.querySelectorAll('section[aria-labelledby="satu-hari-title"] .cols--3 .col');
      if (craftCols.length > 0) {
        gsap.from(craftCols, {
          scrollTrigger: {
            trigger: 'section[aria-labelledby="satu-hari-title"] .cols--3',
            start: "top 85%",
            once: true,
          },
          y: 20,
          opacity: 0,
          duration: 0.7,
          stagger: 0.12,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 05 · Layanan — Baris Layanan Berurutan
      const serviceRows = document.querySelectorAll("#layanan .rows .row");
      if (serviceRows.length > 0) {
        gsap.from(serviceRows, {
          scrollTrigger: {
            trigger: "#layanan .rows",
            start: "top 85%",
            once: true,
          },
          y: 24,
          opacity: 0,
          duration: 0.7,
          stagger: 0.12,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 06 · Detail — Grid & Legenda
      const detailPlates = document.querySelectorAll('section[aria-labelledby="detail-title"] .plate');
      if (detailPlates.length > 0) {
        gsap.from(detailPlates, {
          scrollTrigger: {
            trigger: 'section[aria-labelledby="detail-title"] .grid-detail',
            start: "top 85%",
            once: true,
          },
          y: 24,
          opacity: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      const legendItems = document.querySelectorAll('section[aria-labelledby="detail-title"] .legend__item');
      if (legendItems.length > 0) {
        gsap.from(legendItems, {
          scrollTrigger: {
            trigger: 'section[aria-labelledby="detail-title"] .legend',
            start: "top 90%",
            once: true,
          },
          opacity: 0,
          y: 12,
          duration: 0.5,
          stagger: 0.08,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 07 · Cara Kami Bekerja — Kolom & Grid Proses
      const processCols = document.querySelectorAll("#proses .cols--4 .col");
      if (processCols.length > 0) {
        gsap.from(processCols, {
          scrollTrigger: {
            trigger: "#proses .cols--4",
            start: "top 85%",
            once: true,
          },
          y: 24,
          opacity: 0,
          duration: 0.7,
          stagger: 0.12,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      const processPlates = document.querySelectorAll("#proses .grid-process .plate");
      if (processPlates.length > 0) {
        gsap.from(processPlates, {
          scrollTrigger: {
            trigger: "#proses .grid-process",
            start: "top 85%",
            once: true,
          },
          y: 24,
          opacity: 0,
          duration: 0.8,
          stagger: 0.12,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 08 · Tim — Kartu Person
      const teamMembers = document.querySelectorAll('section[aria-labelledby="tim-title"] .grid-team .person');
      if (teamMembers.length > 0) {
        gsap.from(teamMembers, {
          scrollTrigger: {
            trigger: 'section[aria-labelledby="tim-title"] .grid-team',
            start: "top 85%",
            once: true,
          },
          y: 24,
          opacity: 0,
          duration: 0.7,
          stagger: 0.12,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 09 · Testimoni — Slider Container
      const voiceSlider = document.querySelector("#testimoni .voice-slider");
      if (voiceSlider) {
        gsap.from(voiceSlider, {
          scrollTrigger: {
            trigger: voiceSlider,
            start: "top 85%",
            once: true,
          },
          y: 24,
          opacity: 0,
          duration: 0.8,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 10 · FAQ — Kontainer List
      const faqContainer = document.querySelector("#tanya .faq");
      if (faqContainer) {
        gsap.from(faqContainer, {
          scrollTrigger: {
            trigger: faqContainer,
            start: "top 85%",
            once: true,
          },
          y: 20,
          opacity: 0,
          duration: 0.7,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 11 · Inquiry — Intro & Formulir
      const inqIntro = document.querySelector("#mulainya .grid-inquiry__intro");
      const inqForm = document.querySelector("#mulainya .inq__form");
      if (inqIntro && inqForm) {
        gsap.from([inqIntro, inqForm], {
          scrollTrigger: {
            trigger: "#mulainya .grid-inquiry",
            start: "top 80%",
            once: true,
          },
          y: 28,
          opacity: 0,
          duration: 0.8,
          stagger: 0.15,
          ease: "power2.out",
          clearProps: "all",
        });
      }

      // 12 · Penutup — Closing Grid
      const closingContent = document.querySelectorAll('section[aria-labelledby="penutup-title"] .grid-closing > *');
      if (closingContent.length > 0) {
        gsap.from(closingContent, {
          scrollTrigger: {
            trigger: 'section[aria-labelledby="penutup-title"]',
            start: "top 80%",
            once: true,
          },
          y: 28,
          opacity: 0,
          duration: 0.9,
          stagger: 0.15,
          ease: "power3.out",
          clearProps: "all",
        });
      }
    });

    // Fallback aksesibilitas langsung tampil statis tanpa animasi
    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(".gs-hero-item, .gs-hero-media", {
        clearProps: "all",
      });
    });
  }

  // Jalankan saat load awal dan saat navigasi client router Astro
  initAnimations();
  document.addEventListener("astro:page-load", initAnimations);
</script>
