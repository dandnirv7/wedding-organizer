---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { resolveCanonical } from '../lib/seo';
import {
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildWebPageSchema,
} from '../lib/schema';
import { WaButton } from '../capabilities/lead/index.js';
import FramePlate from './_wedding/FramePlate.astro';
import CreditLine from './_wedding/CreditLine.astro';
import EdgeBand from './_wedding/EdgeBand.astro';
import SelectStrip from './_wedding/SelectStrip.astro';
import { copy } from './_wedding/copy';

const pageTitle = 'Wedding Organizer — Lembar Seleksi Dokumentasi Nyata';
const pageDescription =
  'Satu halaman editorial berisi dokumentasi wedding nyata: bukti kerja, layanan, proses, dan ajakan kontak WhatsApp yang tinggal kirim.';
const canonicalUrl = resolveCanonical(Astro.url);

// Single JSON-LD @graph: WebSite + WebPage; Organization only when real
// contact/social facts exist (currently none — stays silent, no fabrication).
const graph = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildWebPageSchema(canonicalUrl, pageTitle, pageDescription),
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl} graph={graph}>
  <Header slot="header">
    <div slot="cta">
      <WaButton text={copy.hero.whatsapp} message={copy.waMessage} />
    </div>
  </Header>

  <!-- 01 HERO — bidang meja, H1 tunggal -->
  <section class="bg-[#17181a] text-[#e9e7e1]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 pt-16 pb-14 md:pt-24 md:pb-20">
      <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase opacity-80">{copy.hero.eyebrow}</p>
      <h1 class="mt-6 max-w-4xl text-[clamp(2.55rem,8.5vw,5.25rem)] font-semibold leading-[1.02] tracking-[-0.015em]">
        {copy.hero.title}
      </h1>
      <p class="mt-6 max-w-[66ch] text-[1.0625rem] md:text-[1.125rem] leading-[1.7] opacity-90">
        {copy.hero.supporting}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-4">
        <a
          href="#work"
          class="font-label inline-flex min-h-[44px] items-center text-base font-semibold tracking-[0.08em] uppercase underline decoration-[#c9302b] decoration-2 underline-offset-8 hover:opacity-80"
        >
          {copy.hero.discover}
        </a>
        <WaButton text={copy.hero.whatsapp} message={copy.waMessage} />
      </div>
      <div class="mt-12">
        <FramePlate frameNo="00" caption="menunggu aset klien · hero" ratio="16/9" width={1600} height={900} />
        <CreditLine no="00" />
      </div>
    </div>
    <EdgeBand roll="ROLL 00 · MENUNGGU ASET" />
  </section>

  <!-- 02 BRAND STATEMENT — bidang kertas -->
  <section class="bg-[#f2f1ec] text-[#1a1c1e]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 section-space">
      <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase text-[#5c6066]">{copy.statement.eyebrow}</p>
      <h2 class="mt-6 max-w-3xl text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">
        {copy.statement.headline}
      </h2>
      <p class="mt-6 max-w-[66ch] text-[1.0625rem] md:text-[1.125rem] leading-[1.7]">{copy.statement.paragraph}</p>
    </div>
  </section>

  <!-- 03 FEATURED WEDDING #work -->
  <section id="work" class="bg-[#f2f1ec] text-[#1a1c1e] scroll-mt-20">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 pb-16 md:pb-24">
      <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase text-[#5c6066]">{copy.featured.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">{copy.featured.title}</h2>
      <div class="mt-10 grid grid-cols-12 gap-5 md:gap-8">
        <div class="col-span-12 lg:col-span-7">
          <FramePlate frameNo="01" caption="menunggu aset klien · utama" ratio="3/2" width={1400} height={933} />
          <CreditLine no="01" class="mt-3" />
        </div>
        <div class="col-span-12 lg:col-span-5 lg:pt-16">
          <FramePlate frameNo="02" caption="menunggu aset klien · pendukung" ratio="4/5" width={960} height={1200} />
          <CreditLine no="02" class="mt-3" />
          <p class="mt-6 max-w-[66ch] text-[1.0625rem] leading-[1.7]">{copy.featured.empty}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 SERVICES #services — editorial list, bukan kartu -->
  <section id="services" class="bg-[#f2f1ec] text-[#1a1c1e] scroll-mt-20 border-t border-[#d9d6ce]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 py-16 md:py-24">
      <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase text-[#5c6066]">{copy.services.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">{copy.services.title}</h2>
      <ol class="mt-10 border-t border-[#d9d6ce]">
        {copy.services.items.map((s) => (
          <li class="grid grid-cols-12 items-baseline gap-2 border-b border-[#d9d6ce] py-6 md:py-8">
            <span class="font-label col-span-2 md:col-span-1 text-sm font-semibold tracking-[0.14em] text-[#5c6066]">{s.no}</span>
            <div class="col-span-10 md:col-span-11">
              <h3 class="text-[1.0625rem] font-semibold">{s.name}</h3>
              <p class="mt-2 max-w-[66ch] text-[1.0625rem] leading-[1.7]">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-base text-[#5c6066]">{copy.services.priceNote}</p>
      <div class="mt-8">
        <WaButton text="Tanya Layanan via WhatsApp" message={copy.waMessage} />
      </div>
    </div>
  </section>

  <!-- 05 PROCESS -->
  <section class="bg-[#f2f1ec] text-[#1a1c1e] border-t border-[#d9d6ce]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 py-16 md:py-24">
      <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase text-[#5c6066]">{copy.process.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">{copy.process.title}</h2>
      <ol class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-4 md:gap-8">
        {copy.process.steps.map((st) => (
          <li class="border-t border-[#d9d6ce] pt-6">
            <p class="font-label text-sm font-semibold tracking-[0.14em] text-[#5c6066]">{st.no}</p>
            <h3 class="mt-3 text-[1.0625rem] font-semibold">{st.name}</h3>
            <p class="mt-2 text-[1.0625rem] leading-[1.7]">{st.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 06 CINEMATIC VIDEO BREAK — bidang meja -->
  <section class="bg-[#17181a] text-[#e9e7e1]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 py-16 md:py-24">
      <FramePlate frameNo="03" caption="menunggu video klien" ratio="16/9" width={1600} height={900} />
      <div class="mt-6 flex flex-col gap-2">
        <CreditLine no="03" place="MENUNGGU ASET" year="—" />
        <p class="text-[1.0625rem] md:text-[1.125rem] leading-[1.7] opacity-90">{copy.videoBreak.caption}</p>
        <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase opacity-70">{copy.videoBreak.empty}</p>
      </div>
    </div>
  </section>

  <!-- 07 VISUAL STORY -->
  <section class="bg-[#f2f1ec] text-[#1a1c1e]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 py-16 md:py-24">
      <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase text-[#5c6066]">{copy.visualStory.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">{copy.visualStory.title}</h2>
      <div class="mt-10">
        <SelectStrip>
          <FramePlate frameNo="04" caption="menunggu aset klien" ratio="4/5" width={800} height={1000} />
          <FramePlate frameNo="05" caption="menunggu aset klien" ratio="1/1" width={800} height={800} />
          <FramePlate frameNo="06" caption="menunggu aset klien" ratio="3/2" width={900} height={600} />
          <FramePlate frameNo="07" caption="menunggu aset klien" ratio="4/5" width={800} height={1000} />
          <FramePlate frameNo="08" caption="menunggu aset klien" ratio="3/2" width={900} height={600} />
        </SelectStrip>
        <p class="mt-6 max-w-[66ch] text-[1.0625rem] leading-[1.7]">{copy.visualStory.empty}</p>
      </div>
    </div>
    <EdgeBand roll="ROLL 02 · MENUNGGU ASET" />
  </section>

  <!-- 08 TESTIMONIAL -->
  <section class="bg-[#f2f1ec] text-[#1a1c1e]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 py-16 md:py-24">
      <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase text-[#5c6066]">{copy.testimonial.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">{copy.testimonial.title}</h2>
      <figure class="mt-10 max-w-3xl border-t border-[#d9d6ce] pt-8">
        <blockquote class="text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">
          “Menunggu testimoni asli dari klien.”
        </blockquote>
        <figcaption class="mt-6">
          <CreditLine no="T1" place="MENUNGGU ASET" year="—" />
          <p class="mt-4 max-w-[66ch] text-[1.0625rem] leading-[1.7]">{copy.testimonial.empty}</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 09 ABOUT #about -->
  <section id="about" class="bg-[#f2f1ec] text-[#1a1c1e] scroll-mt-20 border-t border-[#d9d6ce]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 py-16 md:py-24">
      <div class="grid grid-cols-12 gap-5 md:gap-8">
        <div class="col-span-12 lg:col-span-5">
          <FramePlate frameNo="09" caption="menunggu foto tim" ratio="4/5" width={960} height={1200} />
          <CreditLine no="09" class="mt-3" />
        </div>
        <div class="col-span-12 lg:col-span-7">
          <p class="font-label text-xs font-semibold tracking-[0.14em] uppercase text-[#5c6066]">{copy.about.eyebrow}</p>
          <h2 class="mt-6 text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">{copy.about.title}</h2>
          <p class="mt-6 max-w-[66ch] text-[1.0625rem] md:text-[1.125rem] leading-[1.7]">{copy.about.paragraph}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 FINAL CTA — bidang meja -->
  <section class="bg-[#17181a] text-[#e9e7e1]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8 py-16 md:py-24 text-center">
      <h2 class="mx-auto max-w-3xl text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-[1.12]">
        {copy.finalCta.title}
      </h2>
      <p class="mx-auto mt-6 max-w-[66ch] text-[1.0625rem] md:text-[1.125rem] leading-[1.7] opacity-90">
        {copy.finalCta.paragraph}
      </p>
      <div class="mt-8 flex justify-center">
        <WaButton text={copy.finalCta.button} message={copy.waMessage} />
      </div>
      <div class="mt-12 text-left">
        <FramePlate frameNo="10" caption="menunggu aset klien · penutup" ratio="16/9" width={1600} height={900} />
        <CreditLine no="10" />
      </div>
    </div>
  </section>

  <!-- 11 FOOTER via layout -->

  <!-- Sticky mobile CTA: hanya render bila nomor WhatsApp terisi -->
  <WaButton variant="floating" text={copy.floatingCta} message={copy.waMessage} />
</BaseLayout>
