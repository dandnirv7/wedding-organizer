---
/**
 * SiteFooter — bidang charcoal, empat kolom, baris bawah.
 *
 * Kanal kontak (WhatsApp/Instagram/email) dan wilayah kerja hanya dirender
 * kalau sudah ada isinya di `siteConfig`; yang belum diisi tampil sebagai
 * status berlabel, bukan sebagai tautan mati atau nomor karangan.
 */
import { siteConfig } from '../../config/site';
import { buildWaLink } from '../../capabilities/lead/lib/whatsapp';
import { page } from './content';

const year = new Date().getFullYear();
const waUrl = buildWaLink({ number: siteConfig.contact.whatsapp });
const instagram = siteConfig.socials.instagram;
const email = siteConfig.contact.email;
const areas = siteConfig.serviceAreas;

const waNumber = siteConfig.contact.whatsapp;
const igHandle = siteConfig.socials.instagram ? siteConfig.socials.instagram.replace(/^https?:\/\/(www\.)?instagram\.com\//, '').replace(/\/$/, '') : '';

const contact = [
  waUrl !== '#' && waNumber ? { label: `WhatsApp — ${waNumber}`, href: waUrl, external: true } : null,
  instagram ? { label: `Instagram @${igHandle}`, href: instagram, external: true } : null,
  email ? { label: `Email — ${email}`, href: `mailto:${email}`, external: false } : null,
].filter((item): item is { label: string; href: string; external: boolean } => item !== null);
---

<footer class="field-ink">
  <div class="wrap wrap--slim footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <p class="t-display footer__wordmark">{siteConfig.name}</p>
        <p class="t-item footer__tagline">{siteConfig.tagline}</p>
      </div>

      {page.footer.columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="label label--ink">{column.title}</h2>
          <ul class="footer__list">
            {column.links.map((link) => (
              <li><a class="footer__link" href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <div>
        <h2 class="label label--ink">{page.footer.contactTitle}</h2>
        {contact.length > 0 ? (
          <ul class="footer__list">
            {contact.map((item) => (
              <li>
                <a
                  class="footer__link"
                  href={item.href}
                  {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="footer__list">
            {page.footer.pendingContact.map((label) => (
              <li>
                <span class="footer__link footer__link--pending" aria-disabled="true">{label} — belum diisi</span>
              </li>
            ))}
          </ul>
        )}
        {areas.length > 0 && <p class="footer__areas">{areas.join(' · ')}</p>}
      </div>
    </div>

    <div class="footer__base">
      <p class="footer__copy">© {year} {siteConfig.name}</p>
      {areas.length > 0 && <p class="footer__copy">{areas.join(' · ')} · Indonesia</p>}
    </div>
  </div>
</footer>
