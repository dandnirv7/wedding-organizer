---
/**
 * InquiryForm — form kualifikasi lead yang mengirimnya ke WhatsApp, bukan ke server.
 *
 * Statis penuh: tidak ada endpoint, tidak ada penyimpanan. Tombol submit
 * menyusun pesan dari field lalu membuka wa.me. Tanpa JavaScript, form tetap
 * membuka percakapan yang sama (field-nya hanya tidak ikut tersusun);
 * tanpa nomor WhatsApp di konfigurasi, seluruh form tidak dirender.
 */
import { buildWaLink } from '../../capabilities/lead/lib/whatsapp';
import { inquiryFields, page } from './content';

export interface Props {
  headline: string;
  lede: string;
}

const { headline, lede } = Astro.props;
const waUrl = buildWaLink({ text: page.waMessage });
const hasNumber = waUrl !== '#';

type FieldType = 'text' | 'date' | 'tel' | 'textarea' | 'select';

interface Field {
  name: string;
  label: string;
  type: FieldType;
  required: boolean;
  wide: boolean;
  autocomplete?: string;
  options?: string[];
}

const fields: Field[] = [
  { name: 'nama', label: 'Nama kamu', type: 'text', required: true, autocomplete: 'name', wide: false },
  { name: 'pasangan', label: 'Nama pasangan', type: 'text', required: false, autocomplete: 'name', wide: false },
  { name: 'tanggal', label: 'Tanggal rencana', type: 'date', required: true, wide: false },
  { name: 'lokasi', label: 'Lokasi / venue yang dibayangkan', type: 'text', required: false, wide: false },
  { name: 'tamu', label: 'Perkiraan jumlah tamu', type: 'select', required: true, options: [...inquiryFields.guestRanges], wide: false },
  { name: 'jenis', label: 'Jenis pernikahan', type: 'select', required: false, options: [...inquiryFields.weddingTypes], wide: false },
  { name: 'layanan', label: 'Layanan yang dibutuhkan', type: 'select', required: false, options: [...inquiryFields.serviceNeeds], wide: false },
  { name: 'budget', label: 'Kisaran budget', type: 'select', required: false, options: [...inquiryFields.budgetRanges], wide: true },
  { name: 'kontak', label: 'Nomor yang bisa dihubungi', type: 'tel', required: false, autocomplete: 'tel', wide: false },
  { name: 'pesan', label: 'Ceritakan sedikit rencanamu', type: 'textarea', required: false, wide: true },
];
---

{
  hasNumber && (
    <div>
      <h3 class="t-item">{headline}</h3>
      <p class="lede mt-5">{lede}</p>

      <form
        id="inq"
        class="mt-10"
        action={buildWaLink()}
        method="get"
        data-wa-href={waUrl}
        data-ok={page.finalCta.ok}
        data-required={page.finalCta.errors.required}
      >
        <div class="inq__grid">
          {fields.map((field) => {
            const id = `inq-${field.name}`;
            return (
              <div class:list={['inq__field', { 'inq__wide': field.wide }]}>
                <label class="inq__label" for={id}>
                  {field.label}
                  {!field.required && <span class="inq__hint ms-2 font-normal normal-case tracking-normal">({page.finalCta.optional})</span>}
                  {field.required && <span class="inq__req" aria-hidden="true">*</span>}
                </label>

                {field.type === 'select' ? (
                  <select class="inp" id={id} name={field.name} data-label={field.label} required={field.required}>
                    <option value="">Belum tahu / pilih nanti</option>
                    {(field.options ?? []).map((option) => <option value={option}>{option}</option>)}
                  </select>
                ) : field.type === 'textarea' ? (
                  <textarea
                    class="inp"
                    id={id}
                    name={field.name}
                    data-label={field.label}
                    rows={3}
                    required={field.required}
                    placeholder="Konsep, adat yang dipakai, atau hal yang paling kamu khawatirkan terlewat."
                  />
                ) : (
                  <input
                    class="inp"
                    id={id}
                    name={field.name}
                    type={field.type}
                    data-label={field.label}
                    required={field.required}
                    {...field.autocomplete && { autocomplete: field.autocomplete }}
                  />
                )}
              </div>
            );
          })}
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <button type="submit" class="btn btn--on-ink">{page.finalCta.submit}</button>
          <p class="inq__hint max-w-measure">{page.finalCta.submitHint}</p>
        </div>

        <p class="inq__status mt-6" id="inq-status" role="status" aria-live="polite" hidden></p>
        <div class="inq__status mt-4" id="inq-preview-wrap" hidden>
          <span class="inq__hint">Isi pesan yang akan terbuka:</span>
          <p class="inq__preview mt-2" id="inq-preview"></p>
        </div>
      </form>
    </div>
  )
}

<script>
  import { track } from '../../capabilities/lead/lib/track';

  const form = document.getElementById('inq') as HTMLFormElement | null;

  if (form) {
    const status = document.getElementById('inq-status');
    const previewWrap = document.getElementById('inq-preview-wrap');
    const preview = document.getElementById('inq-preview');
    const base = form.dataset.waHref ?? '';
    const okText = form.dataset.ok ?? '';
    const requiredText = form.dataset.required ?? 'Lengkapi isian wajib dulu.';
    let started = false;

    const values = () => Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

    const compose = (): string => {
      const v = values();
      const lines = [
        'Halo, saya ingin konsultasi soal pernikahan kami.',
        '',
        `Nama: ${v.nama?.trim() || '—'}${v.pasangan?.trim() ? ` & ${v.pasangan.trim()}` : ''}`,
        v.tanggal && `Tanggal rencana: ${v.tanggal}`,
        v.lokasi && `Lokasi: ${v.lokasi}`,
        v.tamu && `Perkiraan tamu: ${v.tamu}`,
        v.jenis && `Jenis pernikahan: ${v.jenis}`,
        v.layanan && `Layanan yang dibutuhkan: ${v.layanan}`,
        v.budget && `Kisaran budget: ${v.budget}`,
        v.kontak && `Nomor yang bisa dihubungi: ${v.kontak}`,
        v.pesan && `\n${v.pesan}`,
      ].filter(Boolean) as string[];
      return lines.join('\n');
    };

    const showPreview = () => {
      if (!previewWrap || !preview) return;
      previewWrap.hidden = false;
      preview.textContent = compose();
    };

    const say = (target: HTMLElement | null, message: string) => {
      if (!target) return;
      target.textContent = message;
      target.hidden = false;
    };

    form.addEventListener(
      'input',
      () => {
        if (!started) {
          started = true;
          track('inquiry_form_start');
        }
        showPreview();
      },
      true,
    );

    // `invalid` tidak bubbled: capture supaya pesan error datang dari
    // rancangan halaman, bukan tooltip bawaan browser.
    form.addEventListener(
      'invalid',
      (event) => {
        const el = event.target;
        if (!(el instanceof HTMLElement)) return;
        el.setAttribute('aria-invalid', 'true');
        event.preventDefault();
        say(status, requiredText.replace('{field}', (el.dataset.label ?? 'field wajib').toLowerCase()));
        el.focus();
      },
      true,
    );

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      [...form.elements].forEach((el) => el.removeAttribute('aria-invalid'));
      track('inquiry_form_submit', { fields: Object.keys(values()).length });
      say(status, okText);
      window.location.href = `${base.split('?')[0]}?text=${encodeURIComponent(compose())}`;
    });
  }
</script>
