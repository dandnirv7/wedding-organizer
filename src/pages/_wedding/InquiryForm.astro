---
/**
 * InquiryForm — form kualifikasi lead yang menyusun pesan WhatsApp, bukan
 * kiriman ke server.
 *
 * Statis penuh: tidak ada endpoint, tidak ada penyimpanan. Tombol submit
 * menyusun pesan dari field lalu membuka wa.me. Tanpa JavaScript, form tetap
 * membuka percakapan yang sama lewat `method="get"` (field-nya hanya tidak ikut
 * tersusun).
 *
 * Nomor WhatsApp belum diisi → tombol tidak mengirim ke mana pun: pesannya
 * ditampilkan siap disalin, dan statusnya jujur mengatakan nomornya belum
 * dipasang. Tidak ada endpoint pengganti yang dikarang.
 */
import CustomDatePicker from './CustomDatePicker.astro';
import CustomSelect from './CustomSelect.astro';
import { buildWaLink } from '../../capabilities/lead/lib/whatsapp';
import { formOptions, page } from './content';

export interface Props {
  /** Label kecil di atas form; judul blok sudah ada di kolom kiri. */
  eyebrow: string;
  hint: string;
  submit: string;
}

const { eyebrow, hint, submit } = Astro.props;
const base = buildWaLink();
const hasNumber = base !== '#';

type FieldType = 'text' | 'date' | 'tel' | 'textarea' | 'select' | 'radio';

interface Field {
  name: string;
  label: string;
  type: FieldType;
  required?: boolean;
  autocomplete?: string;
  options?: readonly string[];
  hint?: string;
}

const fields: Field[] = [
  { name: 'nama', label: 'Nama kalian', type: 'text', required: true, autocomplete: 'name' },
  { name: 'pasangan', label: 'Nama pasangan', type: 'text', autocomplete: 'name' },
  { name: 'kontak', label: 'Nomor WhatsApp atau email', type: 'text', autocomplete: 'email' },
  { name: 'tanggal', label: 'Tanggal pernikahan (jika sudah ada)', type: 'date' },
  { name: 'lokasi', label: 'Lokasi / venue', type: 'text' },
  { name: 'tamu', label: 'Perkiraan jumlah tamu', type: 'select', options: formOptions.tamu },
];

const services = formOptions.layanan;
---

<div class="inq">
  <p class="label">{eyebrow}</p>

  <form
    id="inq"
    class="inq__form"
    action={hasNumber ? base : undefined}
    method={hasNumber ? 'get' : undefined}
    data-wa-href={base}
    data-has-number={String(hasNumber)}
    data-default-message={page.waMessage}
  >
    <div class="inq__fields">
      {
        fields.map((field) => {
          const id = `inq-${field.name}`;
          const isCustomControl = field.type === 'select' || field.type === 'date';
          const labelFor = isCustomControl ? `${id}-trigger` : id;
          return (
            <div class="inq__field">
              <label class="inq__label" for={labelFor} id={`${id}-label`}>
                {field.label}
              </label>

              {field.type === 'select' ? (
                <CustomSelect
                  id={id}
                  name={field.name}
                  label={field.label}
                  options={field.options ?? []}
                  defaultOption="Belum tahu"
                  defaultValue=""
                />
              ) : field.type === 'date' ? (
                <CustomDatePicker
                  id={id}
                  name={field.name}
                  label={field.label}
                  placeholder="Pilih tanggal (jika sudah ada)"
                />
              ) : field.type === 'textarea' ? (
                <textarea
                  class="inq__control inq__control--area"
                  id={id}
                  name={field.name}
                  data-label={field.label}
                  rows="2"
                />
              ) : (
                <input
                  class="inq__control"
                  id={id}
                  name={field.name}
                  type={field.type}
                  data-label={field.label}
                  required={field.required}
                  {...(field.autocomplete && { autocomplete: field.autocomplete })}
                />
              )}
            </div>
          );
        })
      }

      <fieldset class="inq__field inq__fieldset">
        <legend class="inq__label">Layanan yang dibutuhkan</legend>
        <div class="inq__radios">
          {
            services.map((option, i) => (
              <label class="inq__radio" for={`inq-layanan-${i}`}>
                <input
                  type="radio"
                  id={`inq-layanan-${i}`}
                  name="layanan"
                  value={option}
                  checked={i === 0}
                />
                <span class="inq__radio-mark" aria-hidden="true" />
                <span>{option}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="inq__field">
        <label class="inq__label" for="inq-pesan">Ceritakan kebutuhan kalian</label>
        <textarea class="inq__control inq__control--area" id="inq-pesan" name="pesan" data-label="Ceritakan kebutuhan kalian" rows="2" />
      </div>
    </div>

    <p class="inq__hint">{hint}</p>

    <button type="submit" class="btn btn--primary inq__submit">{submit}</button>

    <p class="inq__status" id="inq-status" role="status" aria-live="polite" hidden></p>

    <div class="inq__preview-wrap" id="inq-preview-wrap" hidden>
      <p class="inq__preview-label" id="inq-preview-label">Pesan yang tersusun</p>
      <p class="inq__preview" id="inq-preview" aria-live="polite" aria-labelledby="inq-preview-label"></p>
      <button type="button" class="inq__copy" id="inq-copy" hidden>Salin pesan</button>
    </div>
  </form>
</div>

<script>
  import { track } from '../../capabilities/lead/lib/track';

  const form = document.getElementById('inq') as HTMLFormElement | null;

  if (form) {
    const status = document.getElementById('inq-status');
    const previewWrap = document.getElementById('inq-preview-wrap');
    const preview = document.getElementById('inq-preview');
    const copyBtn = document.getElementById('inq-copy') as HTMLButtonElement | null;
    const hasNumber = form.dataset.hasNumber === 'true';
    const waBase = form.dataset.waHref ?? '';
    let started = false;
    let composed = '';

    const values = () => Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

    const compose = (): string => {
      const v = values();
      const lines = [
        'Halo, saya ingin konsultasi soal pernikahan kami.',
        '',
        `Nama: ${v.nama?.trim() || '—'}${v.pasangan?.trim() ? ` & ${v.pasangan.trim()}` : ''}`,
        v.tanggal && `Tanggal pernikahan: ${v.tanggal}`,
        v.lokasi && `Lokasi: ${v.lokasi}`,
        v.tamu && `Perkiraan tamu: ${v.tamu}`,
        v.layanan && `Layanan yang dibutuhkan: ${v.layanan}`,
        v.kontak && `Nomor WhatsApp atau email: ${v.kontak}`,
        v.pesan && `\n${v.pesan}`,
      ].filter(Boolean) as string[];
      return lines.join('\n');
    };

    const showPreview = () => {
      if (!previewWrap || !preview) return;
      composed = compose();
      previewWrap.hidden = false;
      preview.textContent = composed;
    };

    const say = (message: string) => {
      if (!status) return;
      status.textContent = message;
      status.hidden = false;
    };

    form.addEventListener(
      'input',
      () => {
        if (!started) {
          started = true;
          track('inquiry_form_start');
        }
        showPreview();
      },
      true,
    );

    form.addEventListener(
      'change',
      () => {
        showPreview();
      },
      true,
    );

    // `invalid` tidak bubbles: capture supaya pesan error datang dari
    // rancangan halaman, bukan tooltip bawaan browser.
    form.addEventListener(
      'invalid',
      (event) => {
        const el = event.target;
        if (!(el instanceof HTMLElement)) return;
        el.setAttribute('aria-invalid', 'true');
        event.preventDefault();
        say(`Isi ${(el.dataset.label ?? 'field wajib').toLowerCase()} dulu — itu yang paling dibutuhkan untuk mulai.`);
        el.focus();
      },
      true,
    );

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      [...form.elements].forEach((el) => el.removeAttribute('aria-invalid'));
      track('inquiry_form_submit', { fields: Object.keys(values()).length });
      showPreview();

      if (hasNumber) {
        say('Pesannya sudah siap di WhatsApp. Kalau ada yang mau diubah, tinggal edit sebelum dikirim.');
        window.location.href = `${waBase.split('?')[0]}?text=${encodeURIComponent(compose())}`;
        return;
      }

      // Nomor belum ada: jangan mengarahkan ke mana pun. Beri pesannya saja.
      if (copyBtn) copyBtn.hidden = false;
      say(
        'Nomor WhatsApp MOCA belum dipasang di konfigurasi, jadi pesan ini belum bisa dikirim dari sini. Salin pesannya lalu kirimkan lewat WhatsApp MOCA.'
      );
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(composed);
        say('Pesan tersalin. Tinggal tempel di WhatsApp.');
      } catch {
        say('Browser menolak akses clipboard — select manual teksnya ya.');
      }
    });
  }
</script>
