---
/**
 * CreditLine — kapsel data satu baris lembar: `07 · LOKASI · 2026`.
 * Nomor dan lokasi adalah bagian estetika folio. Tanpa data klien, penandanya
 * dirender sebagai "menunggu data" — tidak ada nama pasangan atau tahun karangan.
 */
export interface Props {
  no: string;
  place?: string;
  year?: string;
  class?: string;
}

const { no, place = 'menunggu data', year = '', class: className = '' } = Astro.props;
---

<p class={`strip ${className}`}>{[no, place, year].filter(Boolean).join(' · ')}</p>
