---
/**
 * SelectStrip — baris kontak 5/3/2 kolom dengan pelat yang bertingkat,
 * bukan grid seragam. Lingkaran seleksi hanya pada pelat terpilih.
 */
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`story-strip ${className}`}>
  <slot />
</div>
