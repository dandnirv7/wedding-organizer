---
/**
 * SheetNav — folio tepi lembar, bukan bar navigasi SaaS.
 * ≥768px (tablet dan desktop): indeks tampil inline. <768px: satu tombol
 * hamburger membuka "indeks lembar" sebagai sheet dari sisi kanan lewat Popover
 * API bawaan HTML (tutup dengan Esc / klik luar / tombol tutup, fokus kembali ke
 * toggle) — tanpa React, tanpa library drawer.
 */
import { siteConfig } from '../../config/site';

export interface Props {
  items: readonly { href: string; label: string }[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<header class={`sheet-nav field-table ${className}`}>
  <div class="sheet flex items-center gap-x-4 py-3 md:gap-x-6 md:py-4">
    <a
      href="#main-content"
      class="folio inline-flex min-h-11 items-center hover:text-table-ink hover:underline decoration-select decoration-2 underline-offset-8"
    >
      {siteConfig.name}
      <span class="ms-2 hidden opacity-70 lg:inline">lembar seleksi</span>
    </a>

    <!-- Tablet + desktop: indeks inline -->
    <nav aria-label="Navigasi lembar" class="ml-auto hidden md:flex">
      <ul class="flex items-center gap-x-5 md:gap-x-6 lg:gap-x-9">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="strip inline-flex min-h-11 items-center hover:text-table-ink hover:underline decoration-select decoration-2 underline-offset-8"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Fallback bila Popover API tidak ada -->
    <nav aria-label="Navigasi lembar (cadangan)" class="nav-fallback ml-auto hidden flex-wrap gap-x-5 py-2 md:hidden">
      {items.map((item) => (
        <a href={item.href} class="strip inline-flex min-h-11 items-center hover:text-table-ink">{item.label}</a>
      ))}
    </nav>

    <button
      type="button"
      class="nav-toggle md:hidden"
      popovertarget="nav-sheet"
      aria-label="Buka indeks lembar"
    >
      <span class="nav-bars" aria-hidden="true"><i /><i /><i /></span>
      <span class="folio">menu</span>
    </button>
  </div>

  <div id="nav-sheet" class="nav-sheet" popover>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="folio">indeks lembar</p>
        <p class="strip mt-2">{items.length} bagian</p>
      </div>
      <button
        type="button"
        class="nav-close"
        popovertarget="nav-sheet"
        popovertargetaction="hide"
        aria-label="Tutup indeks lembar"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none">
          <path d="M2 2l14 14M16 2L2 16" />
        </svg>
      </button>
    </div>

    <nav aria-label="Indeks lembar" class="mt-8">
      <ol>
        {items.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="nav-row"
              data-nav-close
            >
              <span class="nav-no">{String(i + 1).padStart(2, '0')}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="mt-10">
      <slot name="cta" />
    </div>
  </div>
</header>

<script>
  // Hanya satu hal yang Popover API tidak lakukan sendiri: menutup saat tautan
  // internal dipilih (hash change tidak dianggap light dismiss).
  const sheet = document.getElementById('nav-sheet');

  sheet?.addEventListener('click', (e) => {
    const link = e.target instanceof Element ? e.target.closest('[data-nav-close]') : null;
    if (link && typeof sheet.hidePopover === 'function') sheet.hidePopover();
  });
</script>
