---
/**
 * CustomDatePicker — Shadcn-style custom Date Picker component for wedding inquiry form.
 *
 * Implements accessible datepicker with month/year navigation in Indonesian,
 * clean calendar grid, today and selected states, clear button, and seamless
 * integration with parent <form> FormData and live WhatsApp preview.
 */
import { Icon } from 'astro-icon/components';

export interface Props {
  id: string;
  name: string;
  label: string;
  placeholder?: string;
}

const {
  id,
  name,
  label,
  placeholder = 'Pilih tanggal pernikahan',
} = Astro.props;
---

<div class="custom-date" data-date-wrapper>
  <!-- Hidden form input with actual value -->
  <input
    type="hidden"
    id={id}
    name={name}
    value=""
    data-label={label}
    data-date-input
  />

  <!-- Trigger Area -->
  <div class="custom-date__trigger-wrap" data-date-trigger-wrap>
    <button
      type="button"
      class="custom-date__trigger"
      aria-haspopup="dialog"
      aria-expanded="false"
      id={`${id}-trigger`}
      data-date-trigger
    >
      <span class="custom-date__icon" aria-hidden="true">
        <Icon name="ph:calendar-blank" class="custom-date__cal-icon" />
      </span>
      <span class="custom-date__label is-placeholder" data-date-text>
        {placeholder}
      </span>
    </button>

    <button
      type="button"
      class="custom-date__clear"
      aria-label="Hapus tanggal"
      title="Hapus tanggal"
      data-date-clear
      hidden
    >
      <Icon name="ph:x" class="custom-date__clear-icon" />
    </button>
  </div>

  <!-- Floating Popover Calendar -->
  <div
    class="custom-date__popover"
    role="dialog"
    aria-modal="false"
    aria-label="Pilih tanggal pernikahan"
    data-date-popover
    hidden
  >
    <!-- Header with Month Title and Prev/Next buttons -->
    <div class="custom-date__header">
      <button
        type="button"
        class="custom-date__nav-btn"
        aria-label="Bulan sebelumnya"
        data-date-prev
      >
        <Icon name="ph:caret-left" class="custom-date__nav-icon" />
      </button>

      <span class="custom-date__month-title" data-date-title></span>

      <button
        type="button"
        class="custom-date__nav-btn"
        aria-label="Bulan berikutnya"
        data-date-next
      >
        <Icon name="ph:caret-right" class="custom-date__nav-icon" />
      </button>
    </div>

    <!-- Weekday Labels -->
    <div class="custom-date__weekdays" aria-hidden="true">
      <span>Min</span>
      <span>Sen</span>
      <span>Sel</span>
      <span>Rab</span>
      <span>Kam</span>
      <span>Jum</span>
      <span>Sab</span>
    </div>

    <!-- Calendar Grid of Days -->
    <div class="custom-date__grid" role="grid" data-date-grid>
      <!-- Generated by script -->
    </div>

    <!-- Quick Footer Actions -->
    <div class="custom-date__footer">
      <button type="button" class="custom-date__quick-btn" data-date-today>
        Hari ini
      </button>
      <button type="button" class="custom-date__quick-btn" data-date-reset>
        Hapus
      </button>
    </div>
  </div>
</div>

<style>
  .custom-date {
    position: relative;
    inline-size: 100%;
  }

  .custom-date__trigger-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    inline-size: 100%;
    min-block-size: 32px;
    padding: 0 0 0.35rem;
    border-block-end: 1px solid var(--color-hairline-strong);
    transition: border-color 200ms ease;
  }

  .custom-date__trigger-wrap:hover {
    border-block-end-color: var(--color-ink-mute);
  }

  .custom-date__trigger-wrap.is-open {
    border-block-end-color: var(--color-charcoal);
  }

  .custom-date__trigger {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1;
    min-inline-size: 0;
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.35;
    text-align: start;
    cursor: pointer;
  }

  .custom-date__trigger:focus-visible {
    outline: none;
  }

  .custom-date__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-champagne-deep);
  }

  .custom-date__cal-icon {
    inline-size: 16px;
    block-size: 16px;
  }

  .custom-date__label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .custom-date__label.is-placeholder {
    color: var(--color-ink-mute);
  }

  .custom-date__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 20px;
    block-size: 20px;
    border-radius: 2px;
    border: 0;
    background: transparent;
    color: var(--color-ink-mute);
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .custom-date__clear:hover {
    color: var(--color-charcoal);
    background-color: var(--color-beige);
  }

  .custom-date__clear-icon {
    inline-size: 12px;
    block-size: 12px;
  }

  /* Popover Floating Panel */
  .custom-date__popover {
    position: absolute;
    inset-block-start: calc(100% + 4px);
    inset-inline-start: 0;
    inline-size: 300px;
    background-color: #ffffff;
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    box-shadow:
      0 10px 25px -5px rgba(30, 29, 27, 0.12),
      0 8px 10px -6px rgba(30, 29, 27, 0.05);
    z-index: 50;
    padding: 1rem;
    animation: datePopIn 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 380px) {
    .custom-date__popover {
      inline-size: 100%;
      min-inline-size: 270px;
      padding: 0.75rem;
    }
  }

  .custom-date__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 0.875rem;
  }

  .custom-date__month-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-charcoal);
  }

  .custom-date__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 28px;
    block-size: 28px;
    border-radius: 2px;
    border: 1px solid var(--color-hairline);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .custom-date__nav-btn:hover {
    background-color: #f4efe6;
    border-color: var(--color-hairline-strong);
  }

  .custom-date__nav-icon {
    inline-size: 14px;
    block-size: 14px;
  }

  .custom-date__weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    margin-block-end: 0.5rem;
    text-align: center;
  }

  .custom-date__weekdays span {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-mute);
  }

  .custom-date__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  :global(.custom-date__day) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    aspect-ratio: 1;
    border-radius: 2px;
    border: 1px solid transparent;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  :global(.custom-date__day:hover:not(:disabled)) {
    background-color: #f4efe6;
    color: var(--color-charcoal);
  }

  :global(.custom-date__day.is-today) {
    border-color: var(--color-champagne-deep);
    font-weight: 600;
  }

  :global(.custom-date__day.is-selected) {
    background-color: var(--color-charcoal) !important;
    color: #ffffff !important;
    font-weight: 600;
    border-color: var(--color-charcoal);
  }

  :global(.custom-date__day.is-outside) {
    opacity: 0.25;
    pointer-events: none;
  }

  .custom-date__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-start: 0.875rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--color-hairline);
  }

  .custom-date__quick-btn {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-champagne-deep);
    background: none;
    border: none;
    padding: 2px 4px;
    cursor: pointer;
    transition: color 150ms ease;
  }

  .custom-date__quick-btn:hover {
    color: var(--color-charcoal);
  }

  @keyframes datePopIn {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-date__popover {
      animation: none;
    }
  }
</style>

<script>
  const MONTH_NAMES = [
    'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
    'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
  ];

  function setupDatePickers() {
    const wrappers = document.querySelectorAll<HTMLElement>('[data-date-wrapper]');

    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.initialized) return;
      wrapper.dataset.initialized = 'true';

      const trigger = wrapper.querySelector<HTMLButtonElement>('[data-date-trigger]');
      const triggerWrap = wrapper.querySelector<HTMLElement>('[data-date-trigger-wrap]');
      const popover = wrapper.querySelector<HTMLElement>('[data-date-popover]');
      const labelText = wrapper.querySelector<HTMLElement>('[data-date-text]');
      const hiddenInput = wrapper.querySelector<HTMLInputElement>('[data-date-input]');
      const clearBtn = wrapper.querySelector<HTMLButtonElement>('[data-date-clear]');
      const titleSpan = wrapper.querySelector<HTMLElement>('[data-date-title]');
      const grid = wrapper.querySelector<HTMLElement>('[data-date-grid]');
      const prevBtn = wrapper.querySelector<HTMLButtonElement>('[data-date-prev]');
      const nextBtn = wrapper.querySelector<HTMLButtonElement>('[data-date-next]');
      const todayBtn = wrapper.querySelector<HTMLButtonElement>('[data-date-today]');
      const resetBtn = wrapper.querySelector<HTMLButtonElement>('[data-date-reset]');

      if (!trigger || !triggerWrap || !popover || !labelText || !hiddenInput || !grid || !titleSpan) return;

      const placeholderText = labelText.textContent?.trim() || 'Pilih tanggal pernikahan';
      const today = new Date();

      let viewingYear = today.getFullYear();
      let viewingMonth = today.getMonth(); // 0-indexed
      let selectedDate: Date | null = null;

      const formatIndonesianDate = (d: Date): string => {
        return `${d.getDate()} ${MONTH_NAMES[d.getMonth()]} ${d.getFullYear()}`;
      };

      const renderCalendar = () => {
        titleSpan.textContent = `${MONTH_NAMES[viewingMonth]} ${viewingYear}`;
        grid.innerHTML = '';

        const firstDayOfMonth = new Date(viewingYear, viewingMonth, 1).getDay(); // 0 = Sunday
        const daysInMonth = new Date(viewingYear, viewingMonth + 1, 0).getDate();
        const daysInPrevMonth = new Date(viewingYear, viewingMonth, 0).getDate();

        // Previous month filler days
        for (let i = firstDayOfMonth - 1; i >= 0; i--) {
          const dayNum = daysInPrevMonth - i;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'custom-date__day is-outside';
          btn.textContent = String(dayNum);
          btn.disabled = true;
          grid.appendChild(btn);
        }

        // Current month days
        for (let day = 1; day <= daysInMonth; day++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'custom-date__day';
          btn.textContent = String(day);

          const isToday =
            today.getDate() === day &&
            today.getMonth() === viewingMonth &&
            today.getFullYear() === viewingYear;
          if (isToday) btn.classList.add('is-today');

          const isSelected =
            selectedDate &&
            selectedDate.getDate() === day &&
            selectedDate.getMonth() === viewingMonth &&
            selectedDate.getFullYear() === viewingYear;
          if (isSelected) btn.classList.add('is-selected');

          btn.addEventListener('click', (e) => {
            e.preventDefault();
            selectDate(new Date(viewingYear, viewingMonth, day));
          });

          grid.appendChild(btn);
        }

        // Next month filler days (fill up to 35 or 42 cells)
        const totalRendered = firstDayOfMonth + daysInMonth;
        const totalSlots = totalRendered > 35 ? 42 : 35;
        const nextFiller = totalSlots - totalRendered;
        for (let i = 1; i <= nextFiller; i++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'custom-date__day is-outside';
          btn.textContent = String(i);
          btn.disabled = true;
          grid.appendChild(btn);
        }
      };

      const selectDate = (date: Date) => {
        selectedDate = date;
        const formatted = formatIndonesianDate(date);
        hiddenInput.value = formatted;
        labelText.textContent = formatted;
        labelText.classList.remove('is-placeholder');
        if (clearBtn) clearBtn.hidden = false;

        // Dispatch input and change events so parent form syncs
        hiddenInput.dispatchEvent(new Event('input', { bubbles: true }));
        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));

        renderCalendar();
        close();
        trigger.focus();
      };

      const clearDate = () => {
        selectedDate = null;
        hiddenInput.value = '';
        labelText.textContent = placeholderText;
        labelText.classList.add('is-placeholder');
        if (clearBtn) clearBtn.hidden = true;

        hiddenInput.dispatchEvent(new Event('input', { bubbles: true }));
        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));

        renderCalendar();
      };

      const open = () => {
        // Close other open popovers
        document.querySelectorAll<HTMLElement>('[data-date-popover]:not([hidden]), [data-select-popover]:not([hidden])').forEach((p) => {
          if (p !== popover) {
            p.hidden = true;
            const parent = p.closest('[data-date-wrapper], [data-select-wrapper]');
            parent?.querySelector('[data-date-trigger], [data-select-trigger]')?.setAttribute('aria-expanded', 'false');
            parent?.querySelector('.is-open')?.classList.remove('is-open');
          }
        });

        if (selectedDate) {
          viewingYear = selectedDate.getFullYear();
          viewingMonth = selectedDate.getMonth();
        } else {
          viewingYear = today.getFullYear();
          viewingMonth = today.getMonth();
        }

        renderCalendar();
        popover.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        triggerWrap.classList.add('is-open');
      };

      const close = () => {
        popover.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        triggerWrap.classList.remove('is-open');
      };

      const toggle = () => {
        if (popover.hidden) open();
        else close();
      };

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        toggle();
      });

      prevBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        viewingMonth--;
        if (viewingMonth < 0) {
          viewingMonth = 11;
          viewingYear--;
        }
        renderCalendar();
      });

      nextBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        viewingMonth++;
        if (viewingMonth > 11) {
          viewingMonth = 0;
          viewingYear++;
        }
        renderCalendar();
      });

      todayBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        selectDate(new Date(today.getFullYear(), today.getMonth(), today.getDate()));
      });

      resetBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        clearDate();
        close();
        trigger.focus();
      });

      clearBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        clearDate();
      });

      // Keyboard Esc to close
      wrapper.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !popover.hidden) {
          e.preventDefault();
          close();
          trigger.focus();
        }
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest('[data-date-wrapper]')) {
        document.querySelectorAll<HTMLElement>('[data-date-popover]:not([hidden])').forEach((p) => {
          p.hidden = true;
          const parent = p.closest('[data-date-wrapper]');
          parent?.querySelector('[data-date-trigger]')?.setAttribute('aria-expanded', 'false');
          parent?.querySelector('.is-open')?.classList.remove('is-open');
        });
      }
    });
  }

  setupDatePickers();
  document.addEventListener('astro:page-load', setupDatePickers);
</script>
