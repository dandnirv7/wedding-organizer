---
/**
 * ServiceLedger — daftar layanan sebagai baris editorial bernomor.
 * Tiap baris punya aksi WhatsApp sendiri sehingga pesan pertama sudah menyebut
 * layanan yang ditanya — inquiry masuk lebih qualified. Tanpa kartu, tanpa
 * pratinjau yang bertukar, tanpa JavaScript.
 */
import { WaButton } from '../../capabilities/lead/index.js';
import { serviceWaMessage, type ServiceItem } from './serviceTypes';

export interface Props {
  items: ServiceItem[];
  note?: string;
}

const { items, note } = Astro.props;
---

<ol>
  {items.map((item) => (
    <li class="svc-row">
      <span class="svc-no" aria-hidden="true">{item.no}</span>
      <div>
        <h3 class="h-section text-[clamp(1.25rem,2.6vw,1.625rem)]">{item.name}</h3>
        <p class="mt-3 lede">{item.desc}</p>
        <div class="mt-4">
          <WaButton variant="quiet" text={item.waLabel} message={serviceWaMessage(item.name)} />
        </div>
      </div>
    </li>
  ))}
</ol>

{note && <p class="kicker mt-8 max-w-measure">{note}</p>}
