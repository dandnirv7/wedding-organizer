---
/**
 * TestimonialSlider — slider cerita pasangan MOCA.
 *
 * Progressive enhancement:
 * - Slide pertama aktif dan tampil secara statis tanpa JS.
 * - Navigasi panah kiri/kanan dan keyboard ArrowLeft/ArrowRight mengubah slide aktif.
 * - Indikator counter (1 / 3, 2 / 3, 3 / 3) terikat pada tiap slide.
 */
import FramePlate from './FramePlate.astro';
import type { Testimonial } from './content';

export interface Props {
  testimonials: readonly Testimonial[];
  eyebrow: string;
}

const { testimonials, eyebrow } = Astro.props;
---

<div class="voice-slider" id="voice-slider">
  {
    testimonials.map((t, index) => (
      <figure
        class:list={['voice', 'voice-slide', { 'is-active': index === 0 }]}
        data-index={index}
        id={`voice-slide-${index}`}
        aria-hidden={index !== 0 ? 'true' : 'false'}
      >
        <div class="voice__media">
          <FramePlate
            frame={t.frame}
            sizes="(min-width: 64rem) 35vw, 100vw"
            widths={[340, 520, 680]}
          />
        </div>
        <div class="voice__body">
          <p class="chip">{eyebrow}</p>
          <blockquote class="t-quote voice__quote">
            <p>“{t.quote}”</p>
          </blockquote>
          <div class="voice__meta">
            <p class="voice__author">{t.couple}</p>
            {t.context && <p class="voice__context">{t.context}</p>}
          </div>
        </div>
        <figcaption class="voice__bar">
          <span class="voice__count" aria-live="polite">
            {index + 1} / {testimonials.length}
          </span>
          <div class="voice__nav">
            <button
              type="button"
              class="voice__step voice__step--prev"
              aria-label="Testimoni sebelumnya"
              data-dir="prev"
            >
              ←
            </button>
            <button
              type="button"
              class="voice__step voice__step--next"
              aria-label="Testimoni berikutnya"
              data-dir="next"
            >
              →
            </button>
          </div>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .voice-slider {
    position: relative;
    inline-size: 100%;
  }

  .voice-slide:not(.is-active) {
    display: none !important;
  }

  .voice-slide.is-active {
    animation: voiceFadeIn 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes voiceFadeIn {
    from {
      opacity: 0;
      translate: 0 4px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .voice-slide.is-active {
      animation: none;
    }
  }
</style>

<script>
  function initVoiceSlider() {
    const slider = document.getElementById('voice-slider');
    if (!slider) return;

    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.voice-slide'));
    const total = slides.length;
    if (total <= 1) return;

    let currentIndex = 0;

    function goTo(nextIndex: number) {
      if (nextIndex < 0) {
        nextIndex = total - 1;
      } else if (nextIndex >= total) {
        nextIndex = 0;
      }

      currentIndex = nextIndex;

      slides.forEach((slide, idx) => {
        const isActive = idx === currentIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });
    }

    slider.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement)?.closest<HTMLButtonElement>('.voice__step');
      if (!btn) return;

      const dir = btn.dataset.dir;
      if (dir === 'prev') {
        goTo(currentIndex - 1);
      } else if (dir === 'next') {
        goTo(currentIndex + 1);
      }
    });

    slider.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(currentIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(currentIndex + 1);
      }
    });
  }

  initVoiceSlider();
  document.addEventListener('astro:page-load', initVoiceSlider);
</script>
