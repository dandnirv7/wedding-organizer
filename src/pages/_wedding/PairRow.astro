---
/**
 * PairRow — tulang Ruang Ganti.
 * Satu klaim di satu sisi sumbu, buktinya di sisi lain. Isi tiap sisi
 * ditentukan halaman lewat slot, jadi komponen ini tidak tahu apa pun
 * tentang layanan, paket, atau testimoni.
 */
export interface Props {
  prepLabel: string;
  rememberLabel: string;
  /** Sisi bukti pindah ke kiri; dipakai agar ritme tidak monoton. */
  reverse?: boolean;
  class?: string;
}

const { prepLabel, rememberLabel, reverse = false, class: className = '' } = Astro.props;
---

<article class:list={['pair', { 'pair--reverse': reverse }, className]}>
  <div class="pair__a">
    <span class="pair__side">{prepLabel}</span>
    <slot name="prep" />
  </div>
  <div class="pair__axis" aria-hidden="true"></div>
  <div class="pair__b">
    <span class="pair__side">{rememberLabel}</span>
    <slot name="remember" />
  </div>
</article>
