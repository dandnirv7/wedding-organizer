---
/**
 * SectionHead — kepala blok yang sunyi: label + H2 (+ satu kalimat pembuka).
 * Judul membawa bobotnya sendiri; label hanya penanda blok.
 */
export interface Props {
  eyebrow: string;
  headline: string;
  lede?: string;
  /** id anchor pada heading, bukan pada section. */
  headingId?: string;
  class?: string;
}

const { eyebrow, headline, lede, headingId, class: className = '' } = Astro.props;
---

<header class:list={['block', className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="t-section mt-5" id={headingId}>{headline}</h2>
  {lede && <p class="lede mt-6">{lede}</p>}
</header>
