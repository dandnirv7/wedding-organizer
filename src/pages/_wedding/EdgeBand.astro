---
/**
 * EdgeBand — pita tepi film (nomor roll + perforasi + format).
 * Satu-satunya tempat amber tercetak; ia pita, bukan latar bidang.
 */
export interface Props {
  roll?: string;
  frame?: string;
  class?: string;
}

const { roll = 'roll 01', frame = '35 mm', class: className = '' } = Astro.props;
---

<div class={`edge-band ${className}`} aria-hidden="true">
  <span class="folio">{roll}</span>
  <span class="edge-perf">{Array.from({ length: 10 }).map(() => <i />)}</span>
  <span class="folio">{frame}</span>
  <span class="edge-perf" style="margin-inline-start:auto">{Array.from({ length: 10 }).map(() => <i />)}</span>
</div>
