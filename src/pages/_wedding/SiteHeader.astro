---
/**
 * SiteHeader — kop MOCA: wordmark, anchor yang benar-benar ada, satu CTA.
 *
 * Sesuai reference, link nav tampil di layar lebar (≥80rem). Di bawah itu
 * (<80rem) link nav tidak muat di referensinya, jadi halaman tidak kehilangan
 * jalan ke section: satu tombol Menu membuka indeks sebagai sheet bawah lewat
 * Popover API bawaan HTML (Esc / klik luar / tutup, fokus kembali ke tombol).
 * Tanpa Popover API, daftar tautan tetap tampil sebagai baris cadangan.
 */
import { page } from './content';

export interface Props {
  items: readonly { href: string; label: string }[];
}

const { items } = Astro.props;
---

<header class="nav">
  <div class="wrap wrap--slim nav__row">
    <a class="nav__brand" href="#main-content">{page.brand}</a>

    <nav aria-label="Navigasi utama" class="nav__list">
      <ul>
        {items.map((item) => (
          <li>
            <a class="nav__link" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__cta">
      <slot name="cta" />
    </div>

    <button type="button" class="nav__toggle" popovertarget="site-menu" aria-label="Buka menu navigasi">
      <span class="nav__bars" aria-hidden="true"><i /><i /><i /></span>
      Menu
    </button>
  </div>

  <nav class="nav__fallback wrap" aria-label="Navigasi utama">
    {items.map((item) => <a class="nav__link" href={item.href}>{item.label}</a>)}
  </nav>

  <div id="site-menu" class="nav__sheet" popover>
    <div class="nav__sheet-head">
      <p class="label">Navigasi</p>
      <button type="button" class="nav__close" popovertarget="site-menu" popovertargetaction="hide">
        Tutup
      </button>
    </div>
    <ul>
      {items.map((item, i) => (
        <li>
          <a class="nav__sheet-link" href={item.href} data-nav-close>
            <span class="figure">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a class="nav__sheet-link" href={page.formAnchor} data-nav-close>
          <span class="figure">→</span>
          {page.hero.primaryCta}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Popover API tidak menutup sendiri saat tautan hash dipilih.
  const menu = document.getElementById('site-menu');

  menu?.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest('[data-nav-close]') : null;
    if (link && typeof menu.hidePopover === 'function') menu.hidePopover();
  });
</script>
