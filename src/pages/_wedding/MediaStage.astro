---
/**
 * MediaStage — bidang media hero yang tidak peduli isinya apa: foto hari ini,
 * video (autoplay muted loop) besok. Kotak, rasio, dan posisinya tidak pernah
 * berubah, jadi hero tidak perlu dibangun ulang saat aset klien berganti.
 *
 * Video tetap bukan-syarat: pesan utama selalu terbaca lewat teks, playback
 * berhenti pada prefers-reduced-motion, dan preload diminimalkan.
 */
import { Picture } from 'astro:assets';
import type { Frame } from './content';

export interface Props {
  frame: Frame;
  /** Sumber video desktop; varian `mobile` dipakai di layar sempit. */
  video?: string;
  videoMobile?: string;
  eager?: boolean;
  class?: string;
}

const { frame, video, videoMobile, eager = true, class: className = '' } = Astro.props;
---

<figure class:list={['stage-wrap', className]}>
  <div class="stage" style={`--ar: ${frame.width} / ${frame.height};`}>
    {
      video ? (
        <div class="stage__media">
          <video autoplay muted loop playsinline preload="metadata" poster={frame.src.src} aria-hidden="true">
            {videoMobile && <source src={videoMobile} type="video/mp4" media="(max-width: 767px)" />}
            <source src={video} type="video/mp4" />
          </video>
        </div>
      ) : (
        <Picture
          src={frame.src}
          alt={frame.alt}
          widths={[420, 680, 900]}
          sizes="(min-width: 64rem) 46vw, 100vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          {...(eager && { fetchpriority: 'high' })}
        />
      )
    }
  </div>
</figure>
