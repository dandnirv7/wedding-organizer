---
/**
 * FramePlate — pelat radius-0 untuk slot foto/video.
 * Sadar-bidang: di kertas pelat sedikit lebih terang dari bidangnya, di meja
 * sedikit lebih gelap. Slot kosong memakai rasio + dimensi piksel final
 * (anti-CLS) dan berlabel "menunggu aset klien". Saat aset tiba, hanya
 * `src` yang diisi — susunan tidak bergeser.
 */
export interface Props {
  no: string;
  width: number;
  height: number;
  caption?: string;
  src?: string;
  alt?: string;
  /** Lingkaran seleksi merah: satu per kelompok, bukan per pelat. */
  selected?: boolean;
  eager?: boolean;
  class?: string;
}

const {
  no,
  width,
  height,
  caption = 'menunggu aset klien',
  src,
  alt = '',
  selected = false,
  eager = false,
  class: className = '',
} = Astro.props;
---

<figure class={`plate ${className}`}>
  <div class="plate-media" style={`aspect-ratio: ${width} / ${height}`}>
    {src ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        {...eager && { fetchpriority: 'high' }}
      />
    ) : (
      <div class="plate-empty" role="img" aria-label={`Frame ${no} — ${caption}`}>
        <span class="strip">{no} · menunggu aset klien</span>
        <span class="folio">{width} × {height} px</span>
      </div>
    )}
  </div>
  <figcaption class="plate-caption">
    <span class="strip">{no} · {caption}</span>
    {selected ? (
      <svg width="20" height="20" viewBox="0 0 44 44" role="img" aria-label="Seleksi utama">
        <ellipse
          cx="22" cy="22" rx="18" ry="16"
          fill="none"
          stroke="var(--color-select)"
          stroke-width="5"
          stroke-linecap="round"
          transform="rotate(-7 22 22)"
        />
      </svg>
    ) : (
      <span class="folio" aria-hidden="true">{Math.round((width / height) * 100) / 100}:1</span>
    )}
  </figcaption>
</figure>
