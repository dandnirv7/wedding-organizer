---
/**
 * FramePlate — satu slot foto/video berdimensi final.
 *
 * Rasio tata letak sudah terkunci di `content.ts`, jadi aset yang berganti tidak
 * pernah menggeser layout. `frame.sm` dipakai hanya untuk slot yang
 * komposisinya memang berubah di layar sempit; tanpa itu, rasio desktop berlaku
 * di semua lebar.
 *
 * Foto tidak pernah dilayani apa adanya: `<Picture>` menurunkan avif + webp +
 * jpg dengan srcset sesuai `sizes`, dan `width`/`height` asli tetap ikut supaya
 * tidak ada layout shift.
 */
import { Picture } from 'astro:assets';
import type { Frame } from './content';

export interface Props {
  frame: Frame;
  /** Lebar tampil tipikal, mis. "(min-width: 64rem) 46vw, 100vw". */
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { frame, sizes = '(min-width: 64rem) 46vw, 100vw', eager = false, class: className = '' } = Astro.props;
const ar = `--ar: ${frame.width} / ${frame.height};`;
const arSm = frame.sm ? ` --ar-sm: ${frame.sm.width} / ${frame.sm.height};` : '';
---

<figure class:list={['plate', className]}>
  <div class="plate__media" style={`${ar}${arSm}`}>
    <Picture
      src={frame.src}
      alt={frame.alt}
      widths={[420, 680, 900]}
      {sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      {...(eager && { fetchpriority: 'high' })}
    />
  </div>
</figure>
