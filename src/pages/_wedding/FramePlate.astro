---
/**
 * FramePlate — bingkai layar untuk slot foto/video.
 * Slot kosong memakai rasio + dimensi piksel final (anti-CLS) dan satu kalimat
 * jujur "menunggu dokumentasi klien". Saat aset tiba, hanya `src` yang diisi —
 * susunan tidak bergeser. Tanpa teks dimensi, tanpa bar keterangan, tanpa tanda.
 */
export interface Props {
  no: string;
  width: number;
  height: number;
  caption?: string;
  src?: string;
  alt?: string;
  /** Tanda putar untuk slot video. */
  play?: boolean;
  /** @deprecated dipertahankan agar pemanggil lama tidak rusak; tidak dirender. */
  selected?: boolean;
  eager?: boolean;
  class?: string;
}

const {
  no,
  width,
  height,
  caption = 'Menunggu dokumentasi klien',
  src,
  alt = '',
  play = false,
  eager = false,
  class: className = '',
} = Astro.props;
---

<figure class={`screen ${className}`}>
  <div class="screen-media" style={`aspect-ratio: ${width} / ${height}`}>
    {src ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        {...eager && { fetchpriority: 'high' }}
      />
    ) : (
      <div class="screen-empty" role="img" aria-label={`Bingkai ${no} — ${caption}`}>
        {play && (
          <span class="play-mark" aria-hidden="true">
            <svg width="26" height="30" viewBox="0 0 26 30" fill="none">
              <path d="M2 3.5v23l21-11.5L2 3.5Z" fill="#f0a500" />
            </svg>
          </span>
        )}
        <p>{caption}</p>
      </div>
    )}
  </div>
</figure>
