---
/**
 * FramePlate — pelat radius-0 untuk slot foto/video.
 * Satu bidang: di kertas pelat sedikit lebih terang dari bidangnya, di tinta sedikit
 * lebih gelap. Slot kosong memakai rasio + dimensi piksel final (anti-CLS) dan
 * berlabel "menunggu aset klien" — saat aset tiba hanya isinya yang berganti.
 * Penanda `tick` hijau cuma satu per lembar: cue yang sudah pasti terisi.
 */
export interface Props {
  no: string;
  width: number;
  height: number;
  caption?: string;
  src?: string;
  alt?: string;
  /** Tick hijau #2f6b57: baris ini sudah dikonfirmasi, bukan lingkaran seleksi. */
  tick?: boolean;
  eager?: boolean;
  class?: string;
}

const {
  no,
  width,
  height,
  caption = 'menunggu aset klien',
  src,
  alt = '',
  tick = false,
  eager = false,
  class: className = '',
} = Astro.props;
---

<figure class={`plate ${className}`}>
  <div class="plate-media" style={`aspect-ratio: ${width} / ${height}`}>
    {src ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        {...eager && { fetchpriority: 'high' }}
      />
    ) : (
      <div class="plate-empty" role="img" aria-label={`Pelat ${no} — ${caption}`}>
        <span class="strip">menunggu aset klien</span>
        <span class="folio">{width} × {height} px</span>
      </div>
    )}
  </div>
  <figcaption class="plate-caption">
    <span class="strip">{no} · {caption}</span>
    {tick ? (
      <svg width="18" height="18" viewBox="0 0 24 24" role="img" aria-label="Cue dikonfirmasi">
        <path class="plate-tick" d="M4 13.5 L9.5 19 L20 5.5" />
      </svg>
    ) : (
      <span class="folio" aria-hidden="true">{width}×{height}</span>
    )}
  </figcaption>
</figure>
