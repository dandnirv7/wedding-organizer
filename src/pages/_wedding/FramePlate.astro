---
/**
 * FramePlate — satu slot foto/video berdimensi final.
 * Kosong pun bingkainya sudah benar: rasio dan piksel ditetapkan sekarang,
 * jadi saat aset klien tiba hanya isinya yang ditukar dan layout tidak bergeser.
 */
import type { Frame } from './content';

export interface Props {
  frame: Frame;
  src?: string;
  alt?: string;
  eager?: boolean;
  /** Tanpa baris kredit di bawah pelat. */
  bare?: boolean;
  class?: string;
}

const { frame, src, alt = '', eager = false, bare = false, class: className = '' } = Astro.props;
const ratio = Math.round((frame.width / frame.height) * 100) / 100;
---

<figure class:list={['plate', className]}>
  <div class="plate__media" style={`aspect-ratio: ${frame.width} / ${frame.height}`}>
    {
      src ? (
        <img
          src={src}
          alt={alt}
          width={frame.width}
          height={frame.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          {...(eager && { fetchpriority: 'high' })}
        />
      ) : (
        <div
          class="plate__empty"
          role="img"
          aria-label={`Frame ${frame.id} — ${frame.caption}, menunggu aset klien`}
        >
          <span class="plate__dim figure">{frame.width} × {frame.height} px · {ratio}:1</span>
          <span class="plate__tag">{frame.id} · menunggu aset klien</span>
        </div>
      )
    }
  </div>
  {
    !bare && (
      <figcaption class="plate__cap">
        <span>{frame.id} · {frame.caption}</span>
        <span class="figure">{ratio}:1</span>
      </figcaption>
    )
  }
</figure>
