---
/**
 * Colophon — kaki lembar: nama, kontak yang benar-benar ada, area layanan,
 * dan tautan teknis. Tanpa kolom navigasi ala SaaS; baris yang datanya belum
 * diterima tidak dirender.
 */
import { siteConfig } from '../../config/site';
import { buildWaLink } from '../../capabilities/lead/lib/whatsapp.js';

const year = new Date().getFullYear();
const waUrl = buildWaLink({ number: siteConfig.contact.whatsapp });
const instagram = siteConfig.socials.instagram;
const email = siteConfig.contact.email;
const areas = siteConfig.serviceAreas;
---

<footer class="field-table sticky-reserve">
  <div class="sheet py-14 md:py-16">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-8">
      <div>
        <p class="folio">{siteConfig.name}</p>
        <p class="strip mt-3 max-w-measure">{siteConfig.tagline}</p>
      </div>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {waUrl !== '#' && (
          <li>
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="strip hover:text-table-ink hover:underline decoration-select decoration-2 underline-offset-8">
              WhatsApp
            </a>
          </li>
        )}
        {instagram && (
          <li>
            <a href={instagram} target="_blank" rel="noopener noreferrer" class="strip hover:text-table-ink hover:underline decoration-select decoration-2 underline-offset-8">
              Instagram
            </a>
          </li>
        )}
        {email && (
          <li>
            <a href={`mailto:${email}`} class="strip hover:text-table-ink hover:underline decoration-select decoration-2 underline-offset-8">
              Email
            </a>
          </li>
        )}
        {areas.length > 0 && (
          <li><span class="strip">Area · {areas.join(', ')}</span></li>
        )}
      </ul>
    </div>

    <div class="mt-12 pt-6 border-t border-hairline-table flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
      <p class="strip">© {year} {siteConfig.name}</p>
      <p class="strip">
        <a href="/sitemap-index.xml" class="hover:text-table-ink">Sitemap</a>
        {' · '}
        <a href="/llms.txt" class="hover:text-table-ink">llms.txt</a>
      </p>
    </div>
  </div>
</footer>
