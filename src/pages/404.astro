---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './_wedding/SiteHeader.astro';
import { page } from './_wedding/content';
---

<BaseLayout
  title="Halaman tidak ditemukan (404)"
  description="Alamat yang kamu buka bukan bagian dari halaman ini. Kembali untuk membaca layanan, pernikahan yang sudah dikerjakan, dan prosesnya."
  canonical={new URL('/', Astro.site).href}
  robots={{ index: false, follow: true }}
>
  <SiteHeader slot="header" items={page.nav} />

  <section class="field-ivory grow">
    <div class="wrap flex grow flex-col justify-center band-major">
      <p class="eyebrow">404</p>
      <h1 class="t-section mt-5">Halaman ini tidak ada di sini.</h1>
      <p class="lede mt-6">
        Alamat yang kamu buka bukan bagian dari halaman ini. Kembali ke awal untuk membaca layanan, pernikahan yang
        sudah kami kerjakan, alur kerjanya, dan pertanyaan yang biasa muncul sebelum chat pertama.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a class="btn btn--primary" href="/"><span>Kembali ke atas</span></a>
        <a class="link-quiet" href="/#rencana">Mulai konsultasi</a>
      </div>
    </div>
  </section>
</BaseLayout>
