---
/**
 * 404 — barisnya tidak terdaftar di lembar ini. Tetap memakai anatomi cue yang
 * sama supaya halaman galat tidak terasa seperti situs lain; dinonindexkan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SheetKop from './_wedding/SheetKop.astro';
---

<BaseLayout
  title="Baris tidak ditemukan (404)"
  description="Alamat yang Anda buka tidak ada di lembar rundown ini. Kembali ke awal lembar untuk membaca dokumentasi, lingkup kerja, dan urutan hari-H."
  canonical={new URL('/', Astro.site).href}
  robots={{ index: false, follow: true }}
>
  <SheetKop slot="header" />

  <div class="sheet grow">
    <section class="cue-row">
      <div class="cue-mark">
        <span class="cue-time">—</span>
        <span class="cue-label">tidak terdaftar</span>
      </div>
      <div class="cue-body">
        <h1 class="display">Baris ini tidak ada.</h1>
        <p class="lede">
          Alamat yang Anda buka bukan bagian dari lembar ini. Kembali ke awal lembar untuk membaca dokumentasi,
          lingkup kerja, dan contoh urutan hari-H dari cue 00.00.
        </p>
        <a class="cue-link mt-2" href="/">Kembali ke awal lembar</a>
      </div>
    </section>
  </div>
</BaseLayout>
