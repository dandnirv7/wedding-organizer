---
import BaseLayout from '../layouts/BaseLayout.astro';
import SheetNav from './_wedding/SheetNav.astro';
import SelectMark from './_wedding/SelectMark.astro';
import { copy } from './_wedding/copy';
---

<BaseLayout
  title="Lembar tidak ditemukan (404)"
  description="Halaman yang Anda tuju tidak ada di lembar ini. Kembali ke daftar seleksi dokumentasi wedding."
  canonical={new URL('/', Astro.site).href}
  robots={{ index: false, follow: true }}
>
  <SheetNav slot="header" items={copy.sheet.nav} />

  <section class="field-table grow">
    <div class="sheet flex grow flex-col justify-center py-28">
      <p class="folio">lembar 00 — tidak terdaftar</p>
      <h1 class="display mt-5 max-w-none">Lembar ini tidak ada.</h1>
      <p class="lede mt-5 opacity-90">
        Alamat yang Anda buka tidak termasuk dalam lembar seleksi ini. Kembali ke awal lembar untuk membaca
        dokumentasi, layanan, dan prosesnya dari frame 00.
      </p>
      <div class="mt-8">
        <SelectMark href="/" label="Kembali ke lembar utama" />
      </div>
    </div>
  </section>
</BaseLayout>
