---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
const hasContact = Boolean(
  siteConfig.contact.email || siteConfig.contact.phone || siteConfig.contact.whatsapp
);
---

<footer class="bg-[#17181a] text-[#e9e7e1] pt-16 pb-12 border-t border-[#2a2c30]">
  <div class="max-w-[1240px] mx-auto px-5 md:px-8">
    <div class="pb-12 border-b border-[#2a2c30]">
      <!-- Brand -->
      <p class="font-label text-sm font-semibold tracking-[0.14em] uppercase">
        <a href="/">{siteConfig.name}</a>
      </p>
      <p class="mt-4 text-base leading-relaxed max-w-[66ch]">
        {siteConfig.description}
      </p>

      <!-- Navigasi -->
      <nav aria-label="Navigasi Footer" class="mt-8">
        <ul class="flex flex-wrap gap-x-8 gap-y-3 font-label text-sm font-semibold tracking-[0.14em] uppercase">
          <li><a href="/#work" class="hover:opacity-80">Kerja</a></li>
          <li><a href="/#services" class="hover:opacity-80">Layanan</a></li>
          <li><a href="/#about" class="hover:opacity-80">Tentang</a></li>
        </ul>
      </nav>

      <!-- Kontak (only when contact facts are configured) -->
      {hasContact && (
      <div class="mt-8">
        <h2 class="font-label text-sm font-semibold tracking-[0.14em] uppercase">Kontak</h2>
        <ul class="mt-3 space-y-2.5 text-base">
          {siteConfig.contact.email && (
            <li>
              <a href={`mailto:${siteConfig.contact.email}`} class="underline decoration-[#c9302b] decoration-2 underline-offset-8 hover:opacity-80">
                {siteConfig.contact.email}
              </a>
            </li>
          )}
          {siteConfig.contact.phone && (
            <li>
              <a href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, '')}`} class="underline decoration-[#c9302b] decoration-2 underline-offset-8 hover:opacity-80">
                {siteConfig.contact.phone}
              </a>
            </li>
          )}
        </ul>
      </div>
      )}
    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm">
      <p>&copy; {currentYear} {siteConfig.name}. Hak Cipta Dilindungi Undang-Undang.</p>
      <div class="flex items-center gap-6 font-label text-sm tracking-[0.08em] uppercase">
        <a href="/sitemap-index.xml" class="hover:opacity-80">Sitemap</a>
        <a href="/llms.txt" class="hover:opacity-80">LLMs Discovery</a>
      </div>
    </div>
  </div>
</footer>
