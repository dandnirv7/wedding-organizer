---
import type { Thing } from 'schema-dts';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/anybody';
import '@fontsource-variable/familjen-grotesk';
import SeoHead, { type Props as SeoProps } from '../components/seo/SeoHead.astro';
import Schema from '../components/seo/Schema.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

export interface Props extends SeoProps {
  graph?: (Thing | null | undefined)[] | Thing | null;
}

const { graph, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale.split('-')[0]} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <ClientRouter />
    <SeoHead {...seoProps} />
    <Schema graph={graph || null} />
    <!-- Head override contract: pages may inject extra tags here, but MUST NOT
         emit a second title, canonical, robots meta, or JSON-LD script —
         SeoHead and Schema own those. -->
    <slot name="head" />
  </head>
  <body
    class="field-paper flex min-h-full flex-col"
    data-contract="f347f02d · THESIS halaman adalah lembar rundown hari-H, bukan hero wedding generik · WORLD kertas #f0f1ee / tinta #1b1d1b / stabilo #dbe24a tepat dua kali / hijau #2f6b57 satu tick, radius 0, bayangan 0 · FIRST-VIEWPORT kop tinta + cue chip waktu di kanan; gutter 00.00 CUE UTAMA kiri; pelat 00 memecah gutter; H1 condensed kiri; satu cue-link ke #work · FINISH unreviewed and undocumented is unfinished"
  >
    <!-- IMPECCABLE SEED f347f02d · DECISION 6ba3275f — kontrak arah `/` v2 (audit saat finish)
      THESIS: halaman membuktikan kualitas eksekusi dengan menampilkannya sebagai
        lembar kerja: gutter jam, baris berpelisir, penanggung jawab tiap baris.
        Menolak susunan default kategori (hero foto layar penuh + judul serif di
        tengah + tiga kartu layanan + carousel testimoni).
      OWN-WORLD: satu bidang kertas dingin #f0f1ee; tinta #1b1d1b hanya untuk kop,
        baris konfirmasi, dan colophon. Anybody (condensed) untuk data, Familjen
        Grotesk untuk bacaan. Stabilo #dbe24a dipakai tepat dua kali: cue aktif dan
        satu baris aksi. Hijau #2f6b57 untuk satu tick. Radius nol, bayangan nol,
        tanpa serif, tanpa gradient, tanpa lingkaran merah.
      STORY: pengunjung membaca urutan hari-H, melihat siapa memegang tiap baris,
        mengenali bukti kerjanya, lalu tahu persis pesan apa yang terkirim.
      FIRST VIEWPORT: kop sticky tinta berisi nama WO dan chip cue berwarna waktu;
        di bawahnya baris 00.00 CUE UTAMA — gutter jam di kiri dengan kurung siku
        dan pita stabilo, pelat 00 memecah gutter ke kanan, H1 condensed rata kiri,
        satu cue-link "Buka urutan lengkap" ke #work.
      FORM: call sheet fotografis; ritme baca dari gutter ke baris ke pelat ke teks.
      FINISH: unreviewed and undocumented is unfinished; run ini berakhir dengan
        finish review, verdict, dan DESIGN.md. -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:text-ink focus:outline-2 focus:outline-select"
    >
      Menuju ke konten utama
    </a>

    <slot name="header" />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
