---
import type { Thing } from 'schema-dts';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/source-serif-4';
import '@fontsource/archivo-narrow/400.css';
import '@fontsource/archivo-narrow/600.css';
import '@fontsource/archivo-narrow/700.css';
import SeoHead, { type Props as SeoProps } from '../components/seo/SeoHead.astro';
import Schema from '../components/seo/Schema.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

export interface Props extends SeoProps {
  graph?: (Thing | null | undefined)[] | Thing | null;
}

const { graph, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale.split('-')[0]} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <ClientRouter />
    <SeoHead {...seoProps} />
    <Schema graph={graph || null} />
    <!-- Head override contract: pages may inject extra tags here, but MUST NOT
         emit a second title, canonical, robots meta, or JSON-LD script —
         SeoHead and Schema own those. -->
    <slot name="head" />
  </head>
  <body
    class="field-paper flex min-h-full flex-col"
    data-contract="c37c4509 · THESIS lembar seleksi bernomor, bukan hero default · WORLD kertas #f2f1ec / meja #17181a / merah #c9302b, radius 0 · FIRST-VIEWPORT folio kiri-atas + pelat 00 dominan kanan + H1 di tepi kiri + satu SelectMark ke #work · FINISH unreviewed and undocumented is unfinished"
  >
    <!-- IMPECCABLE SEED c37c4509 — kontrak arah `/` (audit saat finish)
      THESIS: halaman membuktikan kualitas eksekusi lewat frame bernomor seperti
        lembar seleksi studio; menolak susunan default kategori (hero foto besar +
        judul di tengah + tiga kartu layanan + carousel testimoni).
      OWN-WORLD: kertas #f2f1ec dan meja #17181a berselang-seling; Source Serif 4
        untuk kalimat, Archivo Narrow untuk data; merah #c9302b hanya lingkaran
        seleksi dan satu baris aksi; radius nol; tanpa bayangan kabur.
      STORY: pengunjung melihat hasil nyata, mengenali gaya, percaya pada detail,
        lalu tahu pesan apa yang akan terkirim ke WhatsApp.
      FIRST VIEWPORT: bidang meja penuh; folio nama kiri-atas; FramePlate 00
        dominan di kanan (~60% viewport) + kapsel kredit; H1 di tepi kiri bawah
        folio; satu SelectMark merah "Lihat lembaran lengkap" ke #work.
      FORM: lembar kontak fotografis; ritme baca dari strip ke pelat ke teks.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
        finish review, the verdict, and DESIGN.md. -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:text-ink focus:outline-2 focus:outline-select"
    >
      Menuju ke konten utama
    </a>

    <slot name="header" />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
