---
import type { Thing } from 'schema-dts';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource/archivo-narrow/400.css';
import '@fontsource/archivo-narrow/600.css';
import '@fontsource/archivo-narrow/700.css';
import SeoHead, { type Props as SeoProps } from '../components/seo/SeoHead.astro';
import Schema from '../components/seo/Schema.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

export interface Props extends SeoProps {
  graph?: (Thing | null | undefined)[] | Thing | null;
}

const { graph, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale.split('-')[0]} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <ClientRouter />
    <SeoHead {...seoProps} />
    <Schema graph={graph || null} />
    <!-- Head override contract: pages may inject extra tags here, but MUST NOT
         emit a second title, canonical, robots meta, or JSON-LD script —
         SeoHead and Schema own those. -->
    <slot name="head" />
  </head>
  <body
    class="field-paper flex min-h-full flex-col"
    data-contract="layar-utama · THESIS video dulu, sisanya bukti · WORLD layar gelap + kertas baca + bara hanya tanda putar · FIRST-VIEWPORT H1 kiri + tombol WA + layar 16:9 · FINISH unreviewed and undocumented is unfinished"
  >
    <!-- IMPECCABLE layar-utama — kontrak arah `/` (audit saat finish)
      THESIS: halaman membuka dengan film — layar video utama dulu, baru bukti
        tertulis; menolak grid tanggal, kartu layanan, dan carousel.
      OWN-WORLD: putih cerah untuk membaca, hitam hangat untuk menonton; emas
        terang hanya tanda putar dan garis aksi; aksi utama balok tegas.
      STORY: pengunjung menonton dulu, membaca bukti bernomor, lalu mengirim
        satu pesan WA yang sudah terisi.
      FIRST VIEWPORT: eyebrow + H1 rata kiri + tombol WA + tautan hasil; layar
        video 16:9 penuh di bawahnya; tanpa tanggal, tanpa heading tengah.
      FORM: babak berjarak lega; ritme baca tonton ke baca ke aksi.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
        finish review, the verdict, and DESIGN.md. -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-paper focus:px-4 focus:py-2 focus:text-ink focus:outline-2 focus:outline-select"
    >
      Menuju ke konten utama
    </a>

    <slot name="header" />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
